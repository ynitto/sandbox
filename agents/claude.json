{
  "name": "claude",
  "headless_autonomy": "tool-loop",
  "relative_cost": 1,
  "command": ["claude", "-p", "--output-format", "text"],
  "prompt_via": "stdin",
  "model_flag": "--model",
  "output": "stdout",
  "empty_output_is_error": true,
  "write_args": ["--dangerously-skip-permissions"],
  "readonly_args": ["--permission-mode", "plan", "--tools", ""],
  "readonly": "enforced",
  "no_session_args": ["--no-session-persistence"],
  "session_log": {
    "format": "jsonl-dir",
    "paths": ["~/.claude/projects"],
    "usage": true,
    "clean": {
      "version_key": "version",
      "rules": [
        {"rule": "drop-line", "field": "isSidechain", "equals": true},
        {"rule": "drop-line", "field": "type", "in": ["progress", "file-history-snapshot"]},
        {"rule": "strip-tag", "tags": ["system-reminder", "command-message", "command-args",
                                       "command-name", "local-command-stdout"]},
        {"rule": "drop-message", "prefixes": ["Caveat: The messages below were generated by the user while running local commands."]},
        {"rule": "truncate-message", "max_chars": 4000}
      ]
    }
  },
  "interactive": {
    "command": ["claude"],
    "readonly_args": ["--permission-mode", "plan"],
    "no_session_args": ["--no-session-persistence"],
    "ready_pattern": "^[[:space:]]*[>?❯›][[:space:]]*$|│[[:space:]]*[>❯›]|\\? for shortcuts",
    "busy_pattern": "esc to interrupt",
    "prompt_inject": "send-keys"
  },
  "errors": [
    {"match": "usage limit reached|you(?:'|\u2019)ve hit your limit|quota exceeded",
     "class": "quota", "quota_kind": "exhausted", "hint": "Claude の利用枠が枯渇しています"},
    {"match": "rate limit|too many requests",
     "class": "quota", "quota_kind": "rate_limit", "hint": "Claude の時限レート制限です"}
  ]
}
