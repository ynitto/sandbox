{
  "name": "kiro",
  "headless_autonomy": "tool-loop",
  "relative_cost": 1,
  "command": [
    "kiro-cli",
    "chat",
    "--no-interactive"
  ],
  "prompt_via": "argv",
  "model_flag": "--model",
  "output": "stdout",
  "empty_output_is_error": true,
  "write_args": [
    "--trust-all-tools"
  ],
  "readonly_args": [
    "--trust-tools="
  ],
  "readonly": "best-effort",
  "no_session_args": [],
  "session_log": {
    "format": "kiro-sqlite",
    "paths": ["~/.kiro/store.db"],
    "usage": false
  },
  "spill": {
    "args": [
      "--trust-tools=fs_read"
    ],
    "instruction": "続きの本文（分析対象のデータや指示の全文）は一時ファイル {file} にあります。まず fs_read でこのファイル全体を読み込み、その内容を対象にしてください。"
  },
  "interactive": {
    "command": [
      "kiro-cli",
      "chat"
    ],
    "write_args": [
      "--trust-all-tools"
    ],
    "readonly_args": [
      "--trust-tools="
    ],
    "ready_pattern": "^[[:space:]]*[>?❯›][[:space:]]*$|!>|│[[:space:]]*[>❯›]|ask a question|describe a task",
    "ready_timeout_sec": 60,
    "prompt_inject": "send-keys"
  },
  "errors": [
    {
      "match": "Monthly request limit reached",
      "class": "quota",
      "quota_kind": "exhausted",
      "hint": "Kiro CLI の月間リクエスト上限に達しています（上限のリセットを待つか別の CLI へ切り替えてください）"
    }
  ]
}
