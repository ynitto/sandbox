{
  "name": "copilot",
  "headless_autonomy": "tool-loop",
  "slash_native": true,
  "relative_cost": 1,
  "command": ["copilot", "-s", "--allow-all-tools", "--no-color"],
  "prompt_via": "argv",
  "prompt_flag": "-p",
  "model_flag": "--model",
  "output": "stdout",
  "empty_output_is_error": true,
  "write_args": ["--allow-all-paths"],
  "readonly_args": ["--available-tools=view,grep,glob", "--disable-builtin-mcps", "--no-custom-instructions"],
  "continue_args": ["--continue"],
  "resume_args": ["--resume", "{session}"],
  "readonly": "best-effort",
  "no_session_args": [],
  "interactive": {
    "command": ["copilot"],
    "turn_completion": "copilot",
    "prompt_inject": "send-keys",
    "ready_tail_lines": 8
  },
  "errors": [
    {"match": "usage limit|quota exceeded", "class": "quota", "quota_kind": "exhausted",
     "hint": "Copilot の利用枠が枯渇しています"},
    {"match": "rate limit|too many requests", "class": "quota", "quota_kind": "rate_limit",
     "hint": "Copilot の時限レート制限です"}
  ]
}
