{
  "name": "codex",
  "headless_autonomy": "tool-loop",
  "relative_cost": 1,
  "command": ["codex", "exec", "--skip-git-repo-check", "--color", "never",
              "--output-last-message", "{output_file}"],
  "command_suffix": ["-"],
  "skill_command_prefix": "$",
  "prompt_via": "stdin",
  "model_flag": "--model",
  "output": "file",
  "empty_output_is_error": true,
  "write_args": ["--dangerously-bypass-approvals-and-sandbox"],
  "readonly_args": ["--sandbox", "read-only"],
  "readonly": "enforced",
  "no_session_args": ["--ephemeral"],
  "session_log": {
    "format": "jsonl-dir",
    "paths": ["~/.codex/sessions"],
    "usage": true,
    "clean": {
      "version_key": "version",
      "rules": [
        {"rule": "truncate-message", "max_chars": 4000}
      ]
    }
  },
  "interactive": {
    "command": ["codex"],
    "readonly_args": ["--sandbox", "read-only"],
    "no_session_args": ["--ephemeral"],
    "busy_pattern": "esc to interrupt",
    "clear_command": "/new",
    "prompt_inject": "send-keys"
  },
  "errors": [
    {"match": "usage limit|quota exceeded", "class": "quota", "quota_kind": "exhausted",
     "hint": "Codex の利用上限に達しています"},
    {"match": "rate limit|too many requests", "class": "quota", "quota_kind": "rate_limit",
     "hint": "Codex の時限レート制限です"}
  ]
}
