{
  "name": "svg-clip-image-editor",
  "version": "0.1.0",
  "description": "SVG のクリップされた画像を、枠を固定したまま拡縮・回転・移動して枠に合わせ込む React コンポーネント（サンプル実装）",
  "author": "sandbox",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./core": "./src/core/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "demo:build": "esbuild demo/main.js --bundle --format=iife --outfile=demo/dist/main.js --define:process.env.NODE_ENV=\\\"production\\\"",
    "demo:shot": "node scripts/screenshot.js"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "jsdom": "26.1.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  }
}
