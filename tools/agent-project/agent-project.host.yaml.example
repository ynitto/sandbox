# PC 単位の宣言（host.yaml）— **このノードの宣言**（何を動かすか・資源・ローカル環境）。
# 推奨配置: ~/.agents/agent-project.host.yaml（cwd に置いてもよい。探索順は cwd → ~/.agents）。
# 起動: agent-project serve（フルノード）/ agent-project worker（projects が空ならワーカー
# ノード lite——別コマンドだが実装は serve と同一。設計 §4.3・C12）。
#
# ── 設定は 2 ファイル（S1）──
#   このファイル（各 PC・共有しない）  … このノードの宣言: 何を動かすか・資源・ローカル環境
#   状態リポジトリ直下 agent-project.yaml（全 PC 共有） … プロジェクトの合意: どう動かすか
#
#   帰属は起動時に検査する。ノード固有のキー（下記の専有項目）をプロジェクト yaml に書くと、
#   state repo 経由で全 PC へ配られて壊れるのでエラーで止まる。逆に「プロジェクトとして
#   どう進めるか」（計画・ゲート・予算・収束・検証・学習・タスク運用）を defaults/overrides に
#   書くと、ノードごとに食い違って実行が非決定になるのでこれもエラーで止まる。
schema_version: 1

# このノード（PC）の身元。省略時はホスト名を正規化（agentcore.nodeid.normalize_node_id）
# して使う——複数 PC で同じ yaml を共有配布する運用なら省略が既定（PC 毎に自動で変わる）。
# 宣言すると環境変数 AGENT_PROJECT_NODE より優先される（宣言が正）。
node_id: pc-a

# ── ノード全体の既定（共有キーの上書き・S1）──
# ここに書けるのは「ノードごとに違ってよい」群だけ:
#   agent_cli / model / act_timeout / verify_timeout / location / concurrency /
#   agent_timeout / actor / notify_cmd / ltm_home / flow_config / verify_cwd
# 優先順位: CLI > projects[].overrides > defaults > プロジェクト yaml > 組み込み既定。
defaults:
  agent_cli: codex          # この PC に入れてある CLI（全プロジェクト共通の既定）

# このノードが監督するプロジェクト（agent-project run --watch を Supervisor が起動・監視・
# 隔離・再起動する）。空なら「ワーカーノード（lite）」——プロジェクトを持たず、余った計算力を
# 板（agent-board）経由の仕事だけに挿す（設計 §4.3。導入は clone + install.sh +
# `agent-project worker init` の最小手順）。
projects:
  - name: example-project          # 省略可（省略時は root から自動生成）
    # 状態専用リポジトリ。**ここが唯一の置き場**——clone を作る前に読める場所が要るため、
    # 状態リポジトリの中（agent-project.yaml）に書いても意味を持てない。
    state_repo: https://gitea.example/you/example-state.git
    branch: main                   # 状態を載せるブランチ（省略時 main）
    # このノードでの clone 先（**絶対パス必須**）。無ければ agent-project が clone する。
    # 既にあるディレクトリを指す場合は origin の一致を検査し、食い違えば起動を止める
    # （黙って旧構成へ書き続ける事故を防ぐ）。
    root: /home/me/agents/example-project-state
    overrides:                     # このノード × このプロジェクトだけの上書き（共有キーのみ）
      model: gpt-5.6-sol

# ── ノード固有のローカルクローン宣言（S3）──
# 手元にある成果物リポジトリのクローン。**共有 repos.json には置けない**——ホスト固有の絶対
# パスが state repo 経由で全 PC へ配られてしまうため（repos.json に local: を書いても無視され、
# 起動時に警告が出る）。URL は正規化して一致判定する（末尾 .git・スラッシュ・大小文字を吸収）。
#
# ここに宣言すると、次のすべてがネットワーク越しのミラー取り直しを省いて手元から worktree を
# 切る（読み手は agentcore.repolocal の 1 実装）:
#   ・agent-project → agent-flow の run（--workspace に載せて渡す）
#   ・板（agent-board）で落札した仕事（請負ノードが自分の local を載せる）
#   ・検収差分の解決（成果物リポジトリのローカル解決）
#   ・dashboard の CLIチャット起動先（このフォルダを選んで開ける）
repos:
  - url: https://gitea.example/you/app.git
    local: /home/me/mirrors/app

# ── 板（agent-board）参加の宣言 ──
# 板を持たないローカル運用なら board を省略してよい。board を宣言すると、常駐体の board tick
# （30 秒周期）が次を行う:
#   ・板の同期と、このノードの能力宣言 `nodes/<node_id>.json` の書き出し（下の tags /
#     agent_cli / repos / budget.max_concurrent がそのまま載る。心拍は 5 分に 1 回）
#   ・ノード宛て指示の取り込み（`~/.agents/commands/` — dashboard の「引き受ける」「委任を
#     中止」がここへ投函する。板へ書くのは常駐体だけ）
#   ・入札の**自動**判断はここでは行わない。自動入札は各プロジェクトの `participate`
#     （agent-flow / agent-amigos）が担い、落札した仕事はそのプロジェクトのバス経由で実行される
#
# **プロジェクトを 1 つも持たないワーカーノードは、まだ板の仕事を実行できない**
# （落札の取り込み先が無い。ノード直轄実行は Phase 5 / 実装計画 §7 R2b）。dashboard は
# `engine/status.json` の `board.intake_projects` を見て、その端末では「引き受ける」ボタンを
# 理由付きで非活性にする。
#
# 注: ここの `agent_cli` は **このノードで使える CLI の一覧**（板への入札判定に使う能力宣言）で、
# 上の `defaults.agent_cli`（このノードの既定 CLI・スカラ）とは別のキー。
# tags / agent_cli / repos は **入札選別（board_eligible）の正典**でもある——agent-flow 設定の
# `board_repos` / `board_tags` / `board_agent_cli` は明示上書きに降格した（空ならここを読む）。
#
# **板へ配られるのは url だけ**（`repos[].local` は載せない）。あれはこの PC にしかない
# 絶対パスで、板は共有リポジトリ＝置いた値が全 PC へ配られる。手元クローンの利用は各ノードが
# 自分のこのファイルから解決するので、板を経由する必要が無い。
tags: []
agent_cli: []

# このノードが引き受けるエンジン（板の入札選別）。**省略 = 制限しない**（何でも引き受ける）。
# 宣言すると、ここに無い workload の公示には入札しなくなる。設定から推測はしない——
# 「amigos_bus を書いていないから amigos はやらない」と自動で決めると、amigos の板参加を
# 直接起こしている PC が黙って仕事を取らなくなる（入札選別は fail-close なので、
# 誤動作ではなく「なぜかこの PC だけ仕事が来ない」という形で出る）。
# workloads: [flow, amigos]

board: ""
board_workdir: null       # git+ 板の clone 作業領域（ノード局所パスなのでここが置き場）

# amigos 参加 tick（claim・心拍・オーナー職務・板巡回。手番は NodeWorkerPool へ委ねる）の
# 対象バス。未設定なら amigos 参加 tick 自体を skip する（board 未設定時と同じ流儀）。
# amigos_config は agent-amigos の設定ファイル（省略時は agent-amigos 自身の探索順）。
amigos_bus: ""
amigos_config: null

# ノード全体の同時実行数上限（amigos 手番・flow run の NodeWorkerPool 投入を律速し、
# 板では「これ以上は新しく引き受けない」の自己抑制になる）。板の能力宣言
# `nodes/<node_id>.json` にもそのまま載る（依頼側が見る）。
#
#   キーごと省略 … 既定 4（旧 agent-flow daemon の --max-workers に合わせた値）
#   0            … **無制限**（板の契約どおり。上限を掛けない）
#   n            … n 件まで
#
# **0 は無制限**であって「既定に戻す」ではない（板の契約 board.schema.json に合わせた・P2-3）。
# 既定に戻したいならキーごと省略する。無制限は PC の資源を使い切りうるので、意図して
# 選ぶとき以外は書かないこと。
#
# 上限は **PC 単位**。常駐体が起こした手番だけでなく、人が直接叩いた単発実行
# （agent-amigos run --once など。設計 §1.3 C14 が明示的に許す併走）も同じ枠で数える
# ——実行中の手番は ~/.agents/amigos/turns/*.json に印が出て、常駐体がそれを読む。
# 板側の数え方は別（板の上の自分名義の非終端 status/ 件数）——枠の真実は板にあるので
# 二重管理しない。
#
# 管理面（agent-dashboard の「全体設定 → 実行制御 → 同時に動かす数」）が
# `~/.agents/control/control.json` の `workloads.flow.concurrency.max_runs` を宣言していると、
# そちらが優先される（control > 設定ファイル）。画面で空欄にすればこの値へ戻る。
budget:
  max_concurrent: 4

# ── ツールの自動アップデート（S1 でノード側へ移設）──
# 「このノードのインストール管理」なのでプロジェクト共有設定には置かない（置くと更新の停止・
# 更新元の差し替えが全 PC へ一斉に飛び、あるノードだけ版を固定する運用ができない）。
# 省略時は組み込み既定（有効・6 時間ごと・更新元は skill-registry.json から自動解決）。
# update:
#   enabled: true
#   check_interval: 21600
#   repo: ""            # スキルリポジトリ（空なら skill-registry.json から自動解決）
#   branch: main
#   installer: install.sh

# 稼働時間帯（夜間停止）。PC 単位の性質なのでここが単一ソース。省略すると常時稼働。
# 時間の進み方は 3 段:
#   daily_stop - drain_before_sec … drain 開始（新規 claim を止め controller を譲る。
#                                   走っているタスクはそのまま完走させる）
#   daily_stop                    … 停止時間帯に入る
#   daily_stop + shutdown_grace_sec … 常駐体が子を止める（pause。SIGTERM → 猶予 → SIGKILL）
# 止めるのは常に親（常駐体）で、時間帯が戻れば同じ親が resume する。計画停止は死亡回数に
# 数えないので、毎晩止めても隔離（quarantine）には達しない。書式が不正なときは
# **止めたまま**にする（止めたい時間帯に動く方が害が大きい）— status のエラー欄に出る。
# availability:
#   timezone: Asia/Tokyo
#   daily_stop: "23:30"
#   drain_before_sec: 1800
#   shutdown_grace_sec: 300

# 常駐化（PC 起動時に上がる・死んだら上げ直される）をどちらの方式で構成したか（設計 §7）。
# doctor が検査できるのは systemd 側だけで、Windows タスクスケジューラ側は WSL の外から
# 見えない。タスクスケジューラ案を選んだ PC でこれを宣言しないと、doctor が
# 「常駐化が未構成」を出し続ける（正しく構成しているのに誤警告）。
#   auto（既定） … systemd がある環境なら systemd 案とみなして検査する
#   systemd      … install.sh --service で構成した
#   windows-task … Windows タスクスケジューラで構成した（doctor は検査せず人が確認する）
#   none         … 常駐化しない（手動起動のみ）
residency: auto
