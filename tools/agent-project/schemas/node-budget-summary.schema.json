{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Node Budget Summary",
  "description": "ノードごとの予算サマーマップ（status/<node>.json budget block に埋め込む用）",
  "type": "object",
  "properties": {
    "node_id": {"type": "string", "description": "ノード識別子"},
    "budget_period_start": {"type": "integer", "nullable": true, "description": "予算開始時刻（unix timestamp）"},
    "costs": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Cost Breakdown",
      "type": ["object"],
      "properties": {},
      "additionalProperties": {"type": "number"}
    }
  },
  "required": ["node_id"],
  "additionalProperties": false,
  "$comment": "reader は optional フィールドを許容する契約テストで互換性を担保"
}
