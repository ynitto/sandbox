{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/testcase-lint/testcase.schema.json",
  "title": "テストケースのファイル（おすすめの書式）",
  "description": "LLM にケースを書かせるときに渡す書式。条件（conditions）と期待結果を分けて書くと、組み合わせ・判定の強さの点検が推測なしで効く。",
  "type": "object",
  "required": ["cases"],
  "properties": {
    "feature": { "type": "string", "description": "機能のまとまりの名前" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/case" }
    }
  },
  "definitions": {
    "temporary": {
      "type": "object", "required": ["reason"], "additionalProperties": false,
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "status": { "enum": ["temporary", "permanent"] },
        "expires_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "implementation": {
          "type": "object", "required": ["file"], "additionalProperties": false,
          "properties": {
            "file": { "type": "string", "minLength": 1 },
            "marker": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          },
          "anyOf": [{ "required": ["marker"] }, { "required": ["sha256"] }]
        }
      },
      "if": { "properties": { "status": { "const": "permanent" } }, "required": ["status"] },
      "then": { "not": { "anyOf": [{ "required": ["expires_on"] }, { "required": ["implementation"] }] } },
      "else": { "anyOf": [{ "required": ["expires_on"] }, { "required": ["implementation"] }] }
    },
    "case": {
      "type": "object",
      "required": ["id", "title", "steps", "expected"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z]+-\\d+$", "description": "ファイルの中で一意な ID（例: ORD-01）" },
        "title": { "type": "string", "minLength": 1, "description": "何を確かめるかを 1 行で" },
        "requirement": {
          "description": "確かめる要件の ID（仕様の ID と同じ綴り）",
          "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
        },
        "conditions": {
          "type": "object",
          "description": "このケースの条件の組（役割・状態・入力の種類など）。値は文字列。組み合わせの点検に使う",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "preconditions": {
          "type": "array", "items": { "type": "string" },
          "description": "始める前の状態（ログインしている利用者・用意するデータ・開いている画面）"
        },
        "steps": {
          "type": "array", "minItems": 1, "items": { "type": "string" },
          "description": "1 手順 1 操作。入力する値は「」で囲む"
        },
        "expected": {
          "type": "array", "minItems": 1, "items": { "type": "string" },
          "description": "見て確かめられる結果。文言は「」で囲み、件数・値は具体的に書く。失敗するケースは、変わらないこと（保存されていない等）も書く"
        },
        "tags": { "type": "array", "items": { "type": "string" } },
        "group": { "type": "array", "items": { "type": "string" } },
        "origin": {
          "type": "object", "required": ["file", "line", "input_sha256"], "additionalProperties": false,
          "properties": {
            "file": { "type": "string", "minLength": 1, "description": "このJSON/YAMLからの相対の入力元パス" },
            "line": { "type": "integer", "minimum": 1 },
            "definition_line": { "type": "integer", "minimum": 1 },
            "example_line": { "type": "integer", "minimum": 1 },
            "input_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "fields": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "preconditions": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
                "steps": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
                "expected": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
              }
            }
          }
        },
        "priority": { "type": "string" },
        "temporary": { "$ref": "#/definitions/temporary" }
      }
    }
  }
}
