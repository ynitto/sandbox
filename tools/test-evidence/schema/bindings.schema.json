{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ケースと個別テストの対応表",
  "type": "object",
  "required": ["version", "bindings"],
  "properties": {
    "version": {"const": 1},
    "bindings": {"type": "array", "items": {
      "type": "object", "required": ["case", "targets"],
      "properties": {
        "case": {"type": "object", "required": ["file", "id"], "properties": {
          "side": {"type": "string"}, "file": {"type": "string", "minLength": 1}, "id": {"type": "string", "minLength": 1}
        }},
        "targets": {"type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["suite", "file", "selector"], "properties": {
            "suite": {"type": "string", "minLength": 1}, "file": {"type": "string", "minLength": 1}, "selector": {"type": "string", "minLength": 1}
          }
        }}
      }
    }}
  }
}
