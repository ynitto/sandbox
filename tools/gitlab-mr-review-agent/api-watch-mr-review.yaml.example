# api-watch 0.2.0 の dags が作った雛形。作ったあとは自由に直してよい（dags は既にあるファイルを上書きしない）。
# 設定: /home/you/.config/api-watch/api-watch.yaml
# schedule は Dagu がこのワークフローを起動する間隔。取得元に schedule があれば、起動されても予定の時刻までは
# api-watch が取得しない（取得の予定は api-watch の設定にある）。無ければ起動されるたびに取得する
description: "gitlab-mrs を取得し、ルール mr-review で判定して、その場で実行する"
schedule: "* * * * *"
type: graph
hist_retention_days: 14
dotenv:
  - "/home/you/.config/dagu/gitlab-mr-review-agent.env"
steps:
  - name: fetch
    action: exec
    with:
      command: "/usr/bin/python3"
      args:
        - "/home/you/.local/bin/api-watch"
        - "--config"
        - "/home/you/.config/api-watch/api-watch.yaml"
        - "--plugin"
        - "dagu"
        - "--plugin"
        - "/home/you/.local/share/gitlab-mr-review-agent/gitlab_mr.py"
        - "--connections"
        - "/home/you/.github/connections.yaml"
        - "fetch"
        - "--source"
        - "gitlab-mrs"
    timeout_sec: 1620
    retry_policy:
      limit: 3
      interval_sec: 60
      backoff: true
      max_interval_sec: 600
      exit_code: [3]
  - name: evaluate
    depends: [fetch]
    action: exec
    with:
      command: "/usr/bin/python3"
      args:
        - "/home/you/.local/bin/api-watch"
        - "--config"
        - "/home/you/.config/api-watch/api-watch.yaml"
        - "--plugin"
        - "dagu"
        - "--plugin"
        - "/home/you/.local/share/gitlab-mr-review-agent/gitlab_mr.py"
        - "--connections"
        - "/home/you/.github/connections.yaml"
        - "evaluate"
        - "--rule"
        - "mr-review"
    timeout_sec: 600
    retry_policy:
      limit: 2
      interval_sec: 10
  - name: claim
    depends: [evaluate]
    action: exec
    with:
      command: "/usr/bin/python3"
      args:
        - "/home/you/.local/bin/api-watch"
        - "--config"
        - "/home/you/.config/api-watch/api-watch.yaml"
        - "--plugin"
        - "dagu"
        - "--plugin"
        - "/home/you/.local/share/gitlab-mr-review-agent/gitlab_mr.py"
        - "--connections"
        - "/home/you/.github/connections.yaml"
        - "claim"
        - "--rule"
        - "mr-review"
        - "--target"
        - "run"
    timeout_sec: 600
    output: DELIVERY
  - name: render
    depends: [claim]
    action: exec
    with:
      command: "/usr/bin/python3"
      args:
        - "/home/you/.local/bin/api-watch"
        - "--config"
        - "/home/you/.config/api-watch/api-watch.yaml"
        - "--plugin"
        - "dagu"
        - "--plugin"
        - "/home/you/.local/share/gitlab-mr-review-agent/gitlab_mr.py"
        - "--connections"
        - "/home/you/.github/connections.yaml"
        - "render"
        - "${DELIVERY}"
    timeout_sec: 300
    preconditions:              # 取れた受け渡しがあるときだけ（ID は aw_ で始まる）
      - condition: "${DELIVERY}"
        expected: "re:^aw_"
    output: INPUT
  - name: handle
    id: handle
    depends: [render]
    preconditions:              # 取れた受け渡しがあるときだけ（ID は aw_ で始まる）
      - condition: "${DELIVERY}"
        expected: "re:^aw_"
    timeout_sec: 1800
    continue_on:                # 失敗・時間切れでも finish で記録する
      failure: true
    # ワークフロー api-watch-mr-review の handle に差し込むステップ（~/.config/dagu/gitlab-mr-review-agent.handle.yaml にコピーして使う）。
    # api-watch の dags に --handle-step mr-review.run=<このファイル> を付けると、handle の中身としてそのまま入る
    # （name・id・depends・preconditions・timeout_sec・continue_on は dags が付ける）。Dagu v2 の harness.run で kiro-cli を動かす。
    # 終了コードは次の finish が受け取り、0 ならレビューし終えた状態を記録し、それ以外ならあとでやり直す。
    #
    #   provider  kiro（Dagu の組み込み）。kiro-cli はこの PC にインストールしてログインしておく
    #   prompt    render が組んだプロンプト（${INPUT}）。kiro-cli はプロンプトを引数で受け取る
    #   ほかの with の項目は CLI のフラグになる（trust_all_tools: true → --trust-all-tools）
    #
    # Dagu の harness.run が使えない版なら、kiro-cli を直接呼んでもよい（with を次の 2 行に替える）:
    #   action: exec
    #   with: { command: kiro-cli, args: [chat, --no-interactive, --trust-all-tools, "${INPUT}"] }
    action: harness.run
    # kiro-cli を動かすフォルダ。.env の MR_REVIEW_REPO_DIR と同じにする（context が MR の今のコミットを取り出すので、周りのコードを読める）
    working_dir: /home/you/.local/share/gitlab-mr-review-agent/repo
    with:
      provider: kiro
      prompt: "${INPUT}"
      trust_all_tools: true                  # gitlab_mr.py を確認なしで実行させる（無人で動かすため）
      # model: <kiro-cli のモデル名>             # → --model
  - name: finish
    depends: [handle]
    action: exec
    with:
      command: "/usr/bin/python3"
      args:
        - "/home/you/.local/bin/api-watch"
        - "--config"
        - "/home/you/.config/api-watch/api-watch.yaml"
        - "--plugin"
        - "dagu"
        - "--plugin"
        - "/home/you/.local/share/gitlab-mr-review-agent/gitlab_mr.py"
        - "--connections"
        - "/home/you/.github/connections.yaml"
        - "finish"
        - "${DELIVERY}"
        - "--exit-code"
        - "${handle.exit_code}"
    timeout_sec: 600
    preconditions:              # 取れた受け渡しがあるときだけ（ID は aw_ で始まる）
      - condition: "${DELIVERY}"
        expected: "re:^aw_"
