# gitlab-mr-review-agent の設定（~/.config/dagu/gitlab-mr-review-agent.env にコピーして使う）。
# Dagu のワークフローがこのファイルを読み込み（dags --dotenv）、api-watch の設定・接続設定・gitlab_mr.py がここから値を取る。

GITLAB_URL=https://gitlab.example.com
# レビューする MR のあるリポジトリ（group/project か、プロジェクトの ID）
GITLAB_PROJECT=group/project
# api スコープのトークン（MR の読み取りと、コメント・スレッドの解決に使う）。このトークンの持ち主が指摘の書き手になる。
# スレッドを解決にするには、そのプロジェクトで Developer 以上の権限が要る
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxx

# エージェント CLI がレビューの中で呼ぶコマンド（プロンプトに埋める）。python3 と gitlab_mr.py はフルパスで書く
MR_REVIEW_CLI=python3 /home/you/.local/share/gitlab-mr-review-agent/gitlab_mr.py

# 取得の予定・ずらし・絞り込み・再試行・実行の上限は api-watch の設定（api-watch.yaml）に、
# エージェント CLI の種類・フラグ・作業フォルダは handle のステップ（gitlab-mr-review-agent.handle.yaml）に書く
