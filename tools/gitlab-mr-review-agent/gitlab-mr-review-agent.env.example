# gitlab-mr-review-agent の設定（~/.config/dagu/gitlab-mr-review-agent.env にコピーして使う）。
# Dagu のワークフローがこのファイルを読み込み（ワークフローの dotenv）、api-watch の設定・接続設定・gitlab_mr.py がここから値を取る。

GITLAB_URL=https://gitlab.example.com
# レビューする MR のあるリポジトリ（group/project か、プロジェクトの ID）
GITLAB_PROJECT=group/project
# api スコープのトークン（MR の読み取りと、コメント・スレッドの解決に使う）。このトークンの持ち主が指摘の書き手になる。
# スレッドを解決にするには、そのプロジェクトで Developer 以上の権限が要る
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxx

# エージェント CLI がレビューの中で呼ぶコマンド（プロンプトに埋める）。python3 と gitlab_mr.py はフルパスで書く
MR_REVIEW_CLI=python3 /home/you/.local/share/gitlab-mr-review-agent/gitlab_mr.py

# 手元のリポジトリ。既にある作業コピーでよい（作業ツリー・ブランチ・書きかけの変更には触らない）。無ければ prepare が 1 回だけ取ってくる。
# 差分・ファイルはここから git で読み、API には問い合わせない。git fetch は MR の今のコミットが無いときだけ（refs/mr-review/ の下に置く）。
# 空にすると、差分もファイルも API から読む
MR_REVIEW_REPO_DIR=/home/you/work/project
# レビュー用の作業フォルダ（git worktree で足す。MR の今のコミットを取り出し、ほかのファイルは消す）。handle のステップの working_dir と同じにする。
# 既定は MR_REVIEW_REPO_DIR の隣の <名前>.mr-review
MR_REVIEW_WORKTREE=/home/you/work/project.mr-review
# 取ってくる先。既定はリポジトリのリモート origin（その PC の git の認証のまま）。リポジトリが無いときは API の http_url_to_repo。
# HTTPS で GitLab と同じホストなら GITLAB_TOKEN で取る（git の設定ファイルには書かない）
# MR_REVIEW_GIT_REMOTE=origin
# MR_REVIEW_GIT_URL=git@gitlab.example.com:group/project.git

# 取得の予定・ずらし・絞り込み・再試行・実行の上限は api-watch の設定（api-watch.yaml）に、
# kiro-cli のフラグ・作業フォルダは Dagu のワークフロー（api-watch-mr-review.yaml）の handle に書く
