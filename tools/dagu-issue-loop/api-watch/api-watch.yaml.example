# dagu-issue-loop を api-watch で動かすときの api-watch の設定（~/.config/api-watch/api-watch.yaml にコピーして使う）。
#
# issue の取得と変化の検知は api-watch、1 件ずつの実行は Dagu のキュー（同時実行 1）、
# エージェント CLI の起動は issue_loop.py handle が受け持つ。issue_loop.py poll / run と待ち行列は使わない。
#
# GitLab の URL・プロジェクト・トークンは ~/.config/dagu/issue-loop.env にだけ書く。
# connections.yaml の gitlab は次のように書き、値はその環境変数から取る:
#
#   gitlab:
#     - label: default
#       url: ${GITLAB_URL}
#       token: ${GITLAB_TOKEN}
#
# DAG を書き出すときは --dotenv ~/.config/dagu/issue-loop.env を付ける（README の「api-watch で動かす」）。
version: 1
state_dir: ~/.local/state/api-watch

delivery:
  adapter: dagu              # 実行時に --plugin dagu を付ける
  mode: cli
  executable: dagu           # PATH に無ければ dagu のフルパス（Windows は dagu.exe）

sources:
  gitlab-issues:
    connection: gitlab
    request:
      url: "{{ conn.url }}/api/v4/projects/{{ env.GITLAB_PROJECT | urlencode }}/issues"
      headers:
        PRIVATE-TOKEN: "{{ conn.token }}"
      # ISSUE_LOOP_ISSUE_STATE / LABELS / ASSIGNEE と同じ絞り込みにする（handle はキューで待つ間に外れた issue を流さない）
      query: { state: opened, scope: all, order_by: updated_at, sort: asc }
      # query: { state: opened, scope: all, order_by: updated_at, sort: asc, labels: agent, assignee_username: bot-user }
    key: iid
    pagination: { type: page, size_param: per_page, size: 100 }
    schedule: "7 * * * *"    # 1 時間に 1 回。複数の PC で動かすときは分をずらす
    rate_limit: { min_interval_sec: 1 }

rules:
  issue-agent:
    source: gitlab-issues
    id: iid
    # これらのどれかが変わったときだけ渡す（updated_at だけの更新では起こさない）
    watch: [title, state, labels, "assignees[*].username", milestone.title, due_date, user_notes_count, description]
    unordered: [labels]
    on: [appeared, changed]
    initial: baseline        # 初回は今ある issue を覚えるだけ
    targets:
      - workflow: gitlab-issue-handle   # 受け渡し先の DAG（gitlab-issue-handle.yaml）
        queue: gitlab-issue-agent       # Dagu の config.yaml で max_concurrency: 1 にするキュー
        # 失敗した issue は Dagu の再試行のあと打ち切り、次の変化でもう一度拾う。後ろの変化を止めないよう enqueue にする
        order: enqueue
