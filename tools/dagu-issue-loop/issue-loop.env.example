# dagu-issue-loop の設定（~/.config/dagu/issue-loop.env にコピーして使う）

# issue_loop.py を置いたフォルダ（DAG から呼ぶ。絶対パスで書く。Windows も / 区切りでよい）
ISSUE_LOOP_HOME=/home/you/.local/share/dagu-issue-loop
# ISSUE_LOOP_HOME=C:/Users/you/.local/share/dagu-issue-loop
# DAG が使う Python。Windows では python か py
ISSUE_LOOP_PYTHON=python3

# --- GitLab ---
GITLAB_URL=https://gitlab.example.com
GITLAB_PROJECT=group/project
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxx
# ISSUE_LOOP_ISSUE_STATE=opened        # opened / closed / all
# ISSUE_LOOP_ISSUE_LABELS=agent         # カンマ区切り。すべてを持つ issue だけ
# ISSUE_LOOP_ISSUE_ASSIGNEE=bot-user    # この人に割り当てられた issue だけ

# --- エージェント CLI ---
ISSUE_LOOP_AGENT=claude                 # agents/<name>.json の名前（claude / codex / kiro / copilot …）
# ISSUE_LOOP_AGENT_CMD=claude -p --dangerously-skip-permissions   # 直接書くとき（AGENT より優先）
# ISSUE_LOOP_AGENT_PROMPT_VIA=stdin     # AGENT_CMD のときのプロンプトの渡し方: stdin / arg / file
# ISSUE_LOOP_AGENT_MODEL=
ISSUE_LOOP_AGENT_CWD=~/work/project     # エージェントを動かすフォルダ（リポジトリの作業コピー）
# ISSUE_LOOP_AGENT_TIMEOUT=3600
# ISSUE_LOOP_PROMPT_TEMPLATE=~/.config/dagu/issue-loop.prompt.md

# --- 取得 ---
# ISSUE_LOOP_POLL_JITTER=900           # 取得の前にランダムに待つ最大秒数（DAG は --jitter 900 を渡す。手で叩くときは 0）

# --- 再試行 ---
# ISSUE_LOOP_MAX_ATTEMPTS=3             # これだけ失敗したら打ち切り（次に issue が動いたら拾い直す）
# ISSUE_LOOP_RETRY_BACKOFF=300          # 再試行までの秒数（1 回ごとに倍）

# --- api-watch で動かすとき（README の「api-watch で動かす」） ---
# ISSUE_LOOP_APIWATCH=/home/you/.local/bin/api-watch            # Windows は C:/Users/you/AppData/Local/Programs/api-watch/api-watch.pyz
# ISSUE_LOOP_APIWATCH_CONFIG=/home/you/.config/api-watch/api-watch.yaml
# ISSUE_LOOP_APIWATCH_CONNECTIONS=/home/you/.github/connections.yaml
