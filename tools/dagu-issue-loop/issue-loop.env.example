# dagu-issue-loop の設定（~/.config/dagu/issue-loop.env にコピーして使う）。
# Dagu のワークフローがこのファイルを読み込み（dags --dotenv）、api-watch の設定と接続設定がここから値を取る。

GITLAB_URL=https://gitlab.example.com
GITLAB_PROJECT=group/project
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxx

# 取得の予定・ずらし・再試行・絞り込み・実行の上限は api-watch の設定（api-watch.yaml）に、
# エージェント CLI の種類・フラグ・作業フォルダは handle のステップ（issue-loop.handle.yaml）に書く
