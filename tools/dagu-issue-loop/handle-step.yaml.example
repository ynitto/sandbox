# 子のワークフロー api-watch-issue-agent-run の handle に差し込むステップ（~/.config/dagu/issue-loop.handle.yaml にコピーして使う）。
# api-watch の dags に --handle-step issue-agent.run=<このファイル> を付けると、handle の中身としてそのまま入る
# （name・depends・preconditions・timeout_sec は dags が付ける）。Dagu v2 の harness.run でエージェント CLI を動かす。
#
#   provider  claude / codex / kiro / copilot / gemini など（Dagu の組み込み）。CLI はこの PC にインストールしてログインしておく
#   stdin     render が組んだプロンプト（${INPUT}）。claude などは標準入力で受け取る
#   ほかの with の項目は CLI のフラグになる（dangerously_skip_permissions: true → --dangerously-skip-permissions）
action: harness.run
working_dir: /home/you/work/project      # エージェントを動かすフォルダ（リポジトリの作業コピー）
with:
  provider: claude
  prompt: GitLab の issue に変化がありました。標準入力の指示に従って対応してください。
  stdin: "${INPUT}"
  dangerously_skip_permissions: true     # 権限の確認で止まらないように（無人で動かすため）
  # model: sonnet
