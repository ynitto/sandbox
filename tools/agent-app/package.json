{
  "name": "agent-app",
  "version": "0.2.0",
  "description": "GitHub Copilot App 風のデスクトップ。agents/*.json の CLI 定義（copilot / claude / codex / kiro …）を tmux 上で対話起動し、ローカルリポジトリに対して会話形式で動かす Electron アプリ。リポジトリのツリー・コード・Markdown（Mermaid）ビュアー付き",
  "author": "sandbox",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/vendor.js",
    "vendor": "node scripts/vendor.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "11.12.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "diff2html": "3.4.56",
    "dompurify": "3.4.14",
    "marked": "18.0.11",
    "mermaid": "11.17.2",
    "statemachine-maker": "file:../statemachine-maker"
  },
  "devDependencies": {
    "electron": "43.6.0"
  }
}
