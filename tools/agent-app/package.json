{
  "name": "agent-app",
  "version": "0.2.0",
  "description": "GitHub Copilot App 風のデスクトップ。agents/*.json の CLI 定義（copilot / claude / codex / kiro …）を tmux 上で対話起動し、ローカルリポジトリに対して会話形式で動かす Electron アプリ。同じリポジトリのタスク（statemachine-use で動くステートマシン）とワークフロー（agent-flow）も、AI との tmux 会話で作って実行できる",
  "author": "sandbox",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/vendor.js",
    "vendor": "node scripts/vendor.js",
    "icon": "node scripts/icon.js",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "predist": "node scripts/check-dist.js",
    "predist:portable": "node scripts/check-dist.js"
  },
  "dependencies": {
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@highlightjs/cdn-assets": "11.12.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "diff2html": "3.4.56",
    "dompurify": "3.4.14",
    "electron": "43.6.0",
    "electron-builder": "^26.15.3",
    "marked": "18.0.11",
    "mermaid": "11.17.2"
  },
  "build": {
    "appId": "jp.sandbox.agent-app",
    "productName": "Agent App",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/yaml/**"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "${name}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "../../agents",
        "to": "agents",
        "filter": [
          "**/*.json"
        ]
      },
      {
        "from": "../../.github/skills/statemachine-use",
        "to": "app-root/.github/skills/statemachine-use",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/node_modules/**"
        ]
      }
    ]
  }
}
