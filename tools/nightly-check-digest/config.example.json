{
  "checks": [
    {
      "name": "codd-lint",
      "type": "findings_file",
      "path": "/home/you/work/my-app/.codd/lint.md",
      "max_age_hours": 12,
      "ignore_patterns": ["^-\\s+なし$"]
    },
    {
      "name": "testcase-lint",
      "type": "json_report",
      "format": "testcase-evidence",
      "path": "/home/you/work/my-app/results/testcase-lint.json",
      "max_age_hours": 12
    },
    {
      "name": "gitlab-repo-sync",
      "type": "json_report",
      "format": "repo-sync-report",
      "path": "/home/you/.local/state/gitlab-repo-sync/last-report.json",
      "max_age_hours": 12
    },
    {
      "name": "change-watch gc",
      "type": "log_file",
      "path": "/home/you/.local/state/change-watch/hub-gc.log",
      "max_age_hours": 12,
      "run_start_pattern": "^gc start ",
      "run_end_pattern": "^gc exit [0-9]+$",
      "failure_patterns": ["^gc exit [1-9][0-9]*$"]
    }
  ]
}
