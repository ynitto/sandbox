{
  "default": "app",
  "targets": {
    "app": {
      "dir": "C:/work/app",
      "gitlab_project": "group/app",
      "mode": "issue",
      "description": "業務アプリのコードと不具合",
      "keywords": [
        "バグ",
        "画面",
        "エラー"
      ]
    },
    "docs": {
      "dir": "C:/work/docs",
      "gitlab_project": "group/docs",
      "mode": "commit",
      "description": "手順書とマニュアル",
      "keywords": [
        "マニュアル",
        "手順書"
      ],
      "channels": []
    },
    "ops": {
      "dir": "C:/work/ops",
      "gitlab_project": "group/ops",
      "mode": "issue",
      "description": "障害の対応と再発防止",
      "keywords": [
        "障害",
        "アラート"
      ]
    }
  }
}
