# gitlab-mr-review-agent の設定（~/.config/change-watch/gitlab-mr-review-agent/gitlab-mr-review-agent.env にコピーして使う）。
# Dagu のワークフローがこのファイルを読み込み（ワークフローの dotenv）、change-watch の設定・接続設定・gitlab_mr.py がここから値を取る。

GITLAB_URL=https://gitlab.example.com
# レビューする MR のあるリポジトリ（group/project か、プロジェクトの ID）
GITLAB_PROJECT=group/project
# api スコープのトークン（MR の読み取りと、コメント・スレッドの解決に使う）。このトークンの持ち主が指摘の書き手になる。
# スレッドを解決にするには、そのプロジェクトで Developer 以上の権限が要る
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxx

# エージェント CLI がレビューの中で呼ぶコマンド（プロンプトに埋める）。change-watch はフルパスで書く。--plugin は名前でよい（入れてある gitlab_mr.py を change-watch が探す）
MR_REVIEW_CLI=/home/you/.local/bin/change-watch --plugin gitlab_mr mr

# 手元のリポジトリ。既にある作業コピーでよい（作業ツリー・ブランチ・書きかけの変更には触らない）。無ければ prepare が 1 回だけ取ってくる。
# 差分・ファイルはここから git で読み、API には問い合わせない。git fetch は MR の今のコミットが無いときだけ（refs/mr-review/ の下に置く）。
# 空にすると、差分もファイルも API から読む
MR_REVIEW_REPO_DIR=/home/you/work/project
# レビュー用の作業フォルダ（git worktree で足す。MR の今のコミットを取り出し、ほかのファイルは消す）。review のステップの working_dir と同じにする。
# 既定は MR_REVIEW_REPO_DIR の隣の <名前>.mr-review
MR_REVIEW_WORKTREE=/home/you/work/project.mr-review
# 取ってくる先。既定はリポジトリのリモート origin（その PC の git の認証のまま）。リポジトリが無いときは API の http_url_to_repo。
# HTTPS で GitLab と同じホストなら GITLAB_TOKEN で取る（git の設定ファイルには書かない）
# MR_REVIEW_GIT_REMOTE=origin
# MR_REVIEW_GIT_URL=git@gitlab.example.com:group/project.git

# verify で実行を許可する引数の接頭辞（JSON の配列）。設定した接頭辞と先頭から一致するコマンドだけを実行する。接頭辞の後ろには引数を足せる。
# MR_REVIEW_VERIFY_ALLOW=[["python3","-m","unittest"],["npm","test"]]
# verify の制限時間（秒。既定 120、1〜600）
# MR_REVIEW_VERIFY_TIMEOUT_SEC=120

# 独立検証の Dagu 例を使うときに設定する。無人実行フラグは導入先の CLI で確認する。
# MR_REVIEW_PROOF_CLI=/home/you/.local/bin/change-watch --plugin gitlab_proof proof
# 起動コマンドは引数の JSON 配列。{prompt} は依頼の 1 行、{input} は入力ファイルのパス。
# どちらも無ければ依頼を標準入力で渡す。
# MR_REVIEW_PROOF_AGENT=["copilot","-p","{prompt}","--allow-all-tools"]
# MR_REVIEW_PROOF_TIMEOUT_SEC=900
# MR_REVIEW_PROOF_MAX_FINDINGS=20
# 検証エージェントに追加で渡す環境変数の名前（カンマ区切り）。
# MR_REVIEW_PROOF_ENV_PASS=

# IaC リスク検査。1 のときだけ iac post でラベル付けとコメント投稿を行う。
# MR_REVIEW_IAC_POST=0
# MR_REVIEW_IAC_LABEL=needs-extra-approval

# 取得の予定・ずらし・再試行は change-watch の設定（change-watch.yaml）に、
# どの MR をレビューするかの条件・kiro-cli のフラグ・作業フォルダは Dagu のワークフロー（change-watch-mr-review.yaml）に書く
