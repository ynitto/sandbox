# gitlab-mr-review-agent を「条件は Dagu が判定し、change-watch は API へのアクセスだけを受け持つ」形で動かすときの change-watch の設定
# （~/.config/change-watch/gitlab-mr-review-agent/change-watch.yaml をこれに替える）。ルール（rules）は書かない。
# ワークフローは同じフォルダの change-watch-mr-review.yaml.example。
#
# change-watch が受け持つのは、GitLab への問い合わせの予定・間隔・取得中の待ち・失敗の待ちと、「前回 commit してから変わった MR」を
# 返すことだけ。どの MR をレビューするか（ドラフトを除くなど）は、ワークフローの preconditions に書く。
version: 1
state_dir: ~/.local/state/change-watch/gitlab-mr-review-agent   # エージェントごとに分ける

sources:
  gitlab-mrs:
    connection: gitlab
    request:
      url: "{{ conn.url }}/api/v4/projects/{{ env.GITLAB_PROJECT | urlencode }}/merge_requests"
      headers:
        PRIVATE-TOKEN: "{{ conn.token }}"
      query: { state: opened, scope: all, order_by: updated_at, sort: asc }
    key: iid                   # get --consumer が変化を見分ける key
    pagination: { type: page, size_param: per_page, size: 100 }
    schedule: "*/15 * * * *"
    jitter_sec: 300
    busy_wait_sec: 600
    failure_backoff_sec: 300
    rate_limit: { min_interval_sec: 1, group: gitlab }   # 同じ GitLab を見るほかの取得元と、要求の間隔・失敗の待ちを分け合う
