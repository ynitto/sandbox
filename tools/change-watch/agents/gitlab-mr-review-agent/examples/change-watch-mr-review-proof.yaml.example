# 独立検証を使う例。パスを設定し、既存の change-watch-mr-review.yaml と置き換える。
description: "GitLab の MR に積まれたコミットを受け取り、条件に合えば kiro-cli で 1 件をレビューし、独立検証する"
schedule: "* * * * *"
type: graph
hist_retention_days: 14
dotenv:
  - "/home/you/.config/change-watch/gitlab-mr-review-agent/gitlab-mr-review-agent.env"
steps:
  - name: get
    action: exec
    with:
      command: "/home/you/.local/bin/change-watch"
      args:
        - "--config"
        - "/home/you/.config/change-watch/gitlab-mr-review-agent/change-watch.yaml"
        - "--connections"
        - "/home/you/.github/connections.yaml"
        - "get"
        - "--source"
        - "gitlab-mrs"
        - "--consumer"
        - "mr-review"            # commit と同じ名前
        - "--watch"              # 新しいコミット・ドラフトの解除・向き先の変更だけを変化にする（コメントでは起こさない）
        - "sha"
        - "--watch"
        - "draft"
        - "--watch"
        - "target_branch"
        - "--initial"
        - "emit"                 # 初めて動かしたときに開いている MR もレビューする
        - "--one"
    timeout_sec: 720
    retry_policy:              # 一時的な失敗（終了コード 3）だけ再試行する
      limit: 3
      interval_sec: 60
      exit_code: [3]
    output: CHANGE
  - name: review
    id: review
    depends: [get]
    preconditions:              # どの MR をレビューするか（Dagu の条件。${CHANGE.record.*} は MR の項目）
      - condition: "${CHANGE.kind}"
        expected: "re:^(appeared|changed)$"
      - condition: "${CHANGE.record.draft}"
        expected: "false"
    continue_on:
      skipped: true             # 条件に合わなくても commit する
      failure: true             # 失敗しても commit する
    retry_policy:
      limit: 2
      interval_sec: 300
    timeout_sec: 3600
    # kiro-cli の動かし方（Dagu v2 の harness.run）。kiro-cli はプロンプトを引数で受け取る
    action: harness.run
    # kiro-cli を動かすフォルダ。.env の MR_REVIEW_WORKTREE と同じにする（context が MR の今のコミットを取り出す）
    working_dir: /home/you/work/project.mr-review
    with:
      provider: kiro
      prompt: >-
        GitLab のマージリクエスト !${CHANGE.record.iid}「${CHANGE.record.title}」をレビューしてください。
        URL: ${CHANGE.record.web_url} 。
        GitLab への読み書きは ${MR_REVIEW_CLI} のサブコマンドだけで行い、git の commit・push・承認・マージはしないでください。
        まず `${MR_REVIEW_CLI} context ${CHANGE.record.iid} --since=${CHANGE.before.sha}` で概要・前回までの指摘・差分を見て、
        「レビューし終えています」と出たら何もせずに終えてください。前回までの未解決の指摘が直っていれば resolve で閉じ、
        resolve の判断には proof を使わず、今のコミットのファイルを show で読んでください。
        新しく見つけた問題はすぐに comment せず、作業フォルダの外の一時フォルダに JSON でまとめてください。
        JSON は {"version": 1, "findings": [...]} の形にし、指摘ごとに id（重複しない英数字・ハイフン・アンダースコア、64 字まで）、
        target（path と line）、claim（指摘の本文）を書いてください。claim には主張だけを書き、確信度や確認した経緯は書かないでください。
        自分で確かめた内容を残すなら self_assessment に書いてください。
        `${MR_REVIEW_PROOF_CLI} ${CHANGE.record.iid} --findings <そのファイル> --evidence-dir <一時フォルダ>` を 1 回実行してください。
        結果の post の指摘を comment し、本文は claim のまま変えず、evidence_file があれば --evidence-file に渡してください。
        evidence_file が無ければ証拠なしで投稿してください。自分で verify して取った証拠があれば渡してかまいません。
        drop の指摘は投稿しないでください。proof が 0 以外で終わったら、すべての指摘を証拠なしで comment してください。
        最後に summary を 1 回だけ書き、検証済み・仮説・独立検証で取り下げた指摘の件数を分けてください。
        本文は日本語の Markdown で、--body-file に渡すファイルは一時フォルダに書いてください。
      trust_all_tools: true                  # gitlab_mr.py を確認なしで実行させる（無人で動かすため）
  - name: commit
    depends: [review]
    preconditions:              # 受け取った変化があるときだけ
      - condition: "${CHANGE.key}"
        expected: "re:."
    action: exec
    with:
      command: "/home/you/.local/bin/change-watch"
      args:
        - "--config"
        - "/home/you/.config/change-watch/gitlab-mr-review-agent/change-watch.yaml"
        - "--connections"
        - "/home/you/.github/connections.yaml"
        - "commit"
        - "--source"
        - "gitlab-mrs"
        - "--consumer"
        - "mr-review"
        - "${CHANGE.key}"
    timeout_sec: 600
