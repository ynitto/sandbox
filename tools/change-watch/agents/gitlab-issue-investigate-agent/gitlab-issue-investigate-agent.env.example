# install.py install --agent gitlab-issue-investigate-agent が ~/.config/change-watch/gitlab-issue-investigate-agent/ に置く。
# Dagu の dotenv が読む。コメント投稿に使うトークンには api スコープが要る。
GITLAB_URL=https://gitlab.example.com
GITLAB_PROJECT=group/project
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxx

ISSUE_INVESTIGATE_TITLE_CONTAINS=障害調査
ISSUE_INVESTIGATE_WORK_DIR=/home/you/work/project

# Dagu のログで依頼内容と投稿先を確かめてから 0 にする。
ISSUE_INVESTIGATE_DRY_RUN=1

# ISSUE_INVESTIGATE_GOALIE_PY=/home/you/work/sandbox/tools/goalie/goalie.py
# ISSUE_INVESTIGATE_TIMEOUT_SEC=3600
# ISSUE_INVESTIGATE_STATE_DIR=/home/you/.local/state/change-watch/gitlab-issue-investigate-agent
