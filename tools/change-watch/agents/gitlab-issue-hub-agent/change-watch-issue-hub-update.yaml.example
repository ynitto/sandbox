# gitlab-issue-hub-agent の、ハブの issue を変えるワークフロー（install.py install --agent gitlab-issue-hub-agent が
# ~/.config/dagu/dags/change-watch-issue-hub-update.yaml に、この PC のパスにして置く）。
# 予定では動かさない。ほかのワークフローやコマンド行から、変えたいことを COMMENT・UPDATE で渡して動かす:
#   dagu start change-watch-issue-hub-update -- COMMENT="夜間バッチが終わりました"
#   dagu start change-watch-issue-hub-update -- UPDATE='{"add_labels": "完了"}'
# COMMENT はコメントとして足し、UPDATE（JSON）は issue の更新（GitLab の「issue を編集」の項目: add_labels・remove_labels・
# description・title・state_event など）として送る。両方渡せばコメントを足してから更新する。
# 変わったことは GitLab がこの issue を見ている人へメールで知らせ、それを受けて何をするかは Power Automate が決める。
# command は install.py install が置いた change-watch。手で置くなら /home/you を自分の場所に直す（exec は ~ を展開しない）。
# Windows では command を python に、args の先頭を change-watch.pyz のフルパスにする（インストーラはそうして置く）。
description: "GitLab のハブの issue にコメントを足す・issue を更新する（変わったことはメールで届く）"
type: graph
hist_retention_days: 14
dotenv:
  - "/home/you/.config/change-watch/gitlab-issue-hub-agent/gitlab-issue-hub-agent.env"
params:
  - COMMENT: ""                 # 足すコメント（空なら足さない）
  - UPDATE: ""                  # issue の更新（JSON。空なら更新しない）
steps:
  - name: compose
    preconditions:              # コメントがあるときだけ
      - condition: "${params.COMMENT}"
        expected: "re:\\S"
    continue_on:
      skipped: true
    action: exec
    with:
      command: "python3"
      args:
        - "/home/you/.local/share/change-watch/agents/gitlab-issue-hub-agent/gitlab_hub.py"
        - "note"
        - "--text=${params.COMMENT}"
    timeout_sec: 60
    output: NOTE
  - name: comment
    depends: [compose]
    preconditions:              # コメントの本文を作れたときだけ
      - condition: "${NOTE}"
        expected: 're:^\{"body"'
    continue_on:
      skipped: true
    action: exec
    with:
      command: "/home/you/.local/bin/change-watch"
      args:
        - "--plugin"
        - "/home/you/.local/share/change-watch/agents/gitlab-issue-hub-agent/gitlab_hub.py"
        - "--config"
        - "/home/you/.config/change-watch/gitlab-issue-hub-agent/change-watch.yaml"
        - "--connections"
        - "/home/you/.github/connections.yaml"
        - "call"
        - "POST"
        - "{{ env.GITLAB_HUB_ISSUE_URL | gitlab_issue_api }}/notes"
        - "--source"
        - "gitlab-hub-notes"
        - "--json"
        - "${NOTE}"
    timeout_sec: 120
    retry_policy:              # 一時的な失敗（終了コード 3）だけ再試行する
      limit: 3
      interval_sec: 60
      exit_code: [3]
  - name: update
    depends: [comment]
    preconditions:              # 更新があるときだけ
      - condition: "${params.UPDATE}"
        expected: "re:^\\s*\\{"
    action: exec
    with:
      command: "/home/you/.local/bin/change-watch"
      args:
        - "--plugin"
        - "/home/you/.local/share/change-watch/agents/gitlab-issue-hub-agent/gitlab_hub.py"
        - "--config"
        - "/home/you/.config/change-watch/gitlab-issue-hub-agent/change-watch.yaml"
        - "--connections"
        - "/home/you/.github/connections.yaml"
        - "call"
        - "PUT"
        - "{{ env.GITLAB_HUB_ISSUE_URL | gitlab_issue_api }}"
        - "--source"
        - "gitlab-hub-notes"
        - "--json"
        - "${params.UPDATE}"
    timeout_sec: 120
    retry_policy:
      limit: 3
      interval_sec: 60
      exit_code: [3]
