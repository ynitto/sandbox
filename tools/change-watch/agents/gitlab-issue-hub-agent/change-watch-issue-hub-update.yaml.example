# gitlab-issue-hub-agent の、ハブの issue を変えるワークフローの例（install.py install --agent gitlab-issue-hub-agent が
# ~/.config/dagu/dags/change-watch-issue-hub-update.yaml に、この PC のパスにして置く）。
# 予定では動かさない。ほかのワークフローやコマンド行から、足すコメントを COMMENT で渡して動かす:
#   dagu start change-watch-issue-hub-update -- COMMENT="夜間バッチが終わりました"
# 長いコメントはファイル（UTF-8）に書いて、COMMENT の代わりに COMMENT_FILE で渡す（コマンド行には長さの上限がある）:
#   dagu start change-watch-issue-hub-update -- COMMENT_FILE="/home/you/work/hub/comment.txt"
# 本文は JSON にしてファイルに書き、call にはそのファイルを渡す（長い本文をコマンド行に載せない）。
# 何を書くかはワークフローが決める。ラベル・説明・状態などを変えるなら、compose を fields 名前=値（説明は description）にし、comment と同じ形で call PUT "{{ … | gitlab_issue_api }}" の
# ステップを書く（--json に GitLab の issue の編集の項目: add_labels・remove_labels・description・title・state_event など）。
# 変わったことは GitLab がこの issue を見ている人へメールで知らせ、それを受けて何をするかは Power Automate が決める。
# command は install.py install が置いた change-watch。手で置くなら /home/you を自分の場所に直す（exec は ~ を展開しない）。
# Windows では command を python に、args の先頭を change-watch.pyz のフルパスにする（インストーラはそうして置く）。
description: "GitLab のハブの issue にコメントを足す（変わったことはメールで届く）"
type: graph
hist_retention_days: 14
dotenv:
  - "/home/you/.config/change-watch/gitlab-issue-hub-agent/gitlab-issue-hub-agent.env"
params:
  - COMMENT: ""                 # 足すコメント
  - COMMENT_FILE: ""            # 足すコメントを書いたファイル（長いとき。COMMENT が空なら使う）
steps:
  - name: compose
    action: exec
    with:
      command: "/home/you/.local/bin/change-watch"
      args:
        - "--plugin"
        - "gitlab_hub"
        - "note"
        - "--text=${params.COMMENT}"
        - "--text-file=${params.COMMENT_FILE}"
        - "--out"
        - "/home/you/.config/change-watch/gitlab-issue-hub-agent/hub-update-note.json"
    timeout_sec: 60
    output: NOTE
  - name: comment
    depends: [compose]
    preconditions:              # 本文があるときだけ（COMMENT も COMMENT_FILE も空なら書かない）
      - condition: "${NOTE}"
        expected: "re:."
    action: exec
    with:
      command: "/home/you/.local/bin/change-watch"
      args:
        - "--plugin"
        - "gitlab_hub"
        - "--config"
        - "/home/you/.config/change-watch/gitlab-issue-hub-agent/change-watch.yaml"
        - "--connections"
        - "/home/you/.github/connections.yaml"
        - "call"
        - "POST"
        - "{{ env.GITLAB_HUB_ISSUE_URL | gitlab_issue_api }}/notes"
        - "--source"
        - "gitlab-hub-notes"
        - "--json-file"
        - "/home/you/.config/change-watch/gitlab-issue-hub-agent/hub-update-note.json"
    timeout_sec: 120
    retry_policy:              # 一時的な失敗（終了コード 3）だけ再試行する
      limit: 3
      interval_sec: 60
      exit_code: [3]
