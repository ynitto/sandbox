# install.py install --agent gitlab-ci-triage-agent が ~/.config/change-watch/gitlab-ci-triage-agent/ に置く。
# Dagu の dotenv が読む。トークンは api スコープで、診断の書き手になる。
GITLAB_URL=https://gitlab.example.com
GITLAB_PROJECT=group/project
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxx
GITLAB_HUB_ISSUE_URL=https://gitlab.example.com/group/project/-/issues/42

# Dagu のログに出る本文と投稿先を確かめてから 0 にする。
CI_TRIAGE_DRY_RUN=1
CI_TRIAGE_PATTERNS=/home/you/.config/change-watch/gitlab-ci-triage-agent/ci-triage-patterns.json
# CI_TRIAGE_COMMIT_SOURCES=push
# CI_TRIAGE_WORK_DIR=/home/you/.local/state/change-watch/gitlab-ci-triage-agent/work
