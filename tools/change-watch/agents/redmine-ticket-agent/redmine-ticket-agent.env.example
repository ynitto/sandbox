# redmine-ticket-agent の設定（~/.config/change-watch/redmine-ticket-agent/redmine-ticket-agent.env にコピーして使う）。
# Dagu のワークフローがこのファイルを読み込み（ワークフローの dotenv）、接続設定と redmine_issue.py close がここから値を取る。

REDMINE_URL=https://redmine.example.com
# 個人設定の「API アクセスキー」。このキーの持ち主が「自分」になる（担当の絞り込み・コメントの書き手）
REDMINE_API_KEY=0123456789abcdef0123456789abcdef01234567

# 対象の文字列・コメントする文・ステータス・取得の予定は change-watch の設定（change-watch.yaml）に書く
