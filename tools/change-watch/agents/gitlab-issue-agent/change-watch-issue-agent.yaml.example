# gitlab-issue-agent の Dagu のワークフロー（install.py install --agent gitlab-issue-agent が
# ~/.config/dagu/dags/change-watch-issue-agent.yaml に、この PC のパスにして置く）。どの issue をどう処理するかは、ここ（Dagu）の条件で決める。
# 毎分起動し、1 回の起動で 1 件を処理する:
#   get     前回 commit してから変わった issue を 1 件受け取る（GitLab に問い合わせるかは取得元の schedule で change-watch が決める）
#   new     新しい issue なら、エージェント CLI に着手させる          ← 条件で分ける（Dagu の preconditions）
#   update  変わった issue なら、変わったところを見て対応させる
#   commit  処理し終えたと記録する（issue を取り直した姿で。エージェント自身のコメントで次に起きない）
# 処理が失敗しても commit する（Dagu の retry_policy でやり直し、尽きたら失敗として Dagu の履歴に残る）。
# 同じ issue に次の変化があれば、また流れる。
# 分け方を足すなら、同じ形のステップを足して preconditions を変え、commit の depends に足す
# （例: ラベル bug が付いた issue だけ別のプロンプトにする → condition: "${CHANGE.record.labels}" expected: 're:"bug"'）。
# new・update の provider・working_dir を自分のものに直す（provider は claude / codex / kiro / copilot / gemini など）。
# command は install.py install が置いた change-watch。手で置くなら /home/you を自分の場所に直す（exec は ~ を展開しない）。
# Windows では command を python に、args の先頭を change-watch.pyz のフルパスにする（インストーラはそうして置く）。
description: "GitLab の issue の変化を受け取り、新しい issue と変わった issue で分けてエージェント CLI に 1 件を処理させる"
schedule: "* * * * *"
type: graph
hist_retention_days: 14
dotenv:
  - "/home/you/.config/change-watch/gitlab-issue-agent/gitlab-issue-agent.env"
steps:
  - name: get
    action: exec
    with:
      command: "/home/you/.local/bin/change-watch"
      args:
        - "--config"
        - "/home/you/.config/change-watch/gitlab-issue-agent/change-watch.yaml"
        - "--connections"
        - "/home/you/.github/connections.yaml"
        - "get"
        - "--source"
        - "gitlab-issues"
        - "--consumer"
        - "issue-agent"          # commit と同じ名前。ワークフローごとに別の名前にすると、それぞれが全部の変化を受け取る
        - "--watch"              # これらのどれかが変わったときだけ変化にする（updated_at だけの更新では起こさない）
        - "title"
        - "--watch"
        - "state"
        - "--watch"
        - "labels"
        - "--watch"
        - "assignees"
        - "--watch"
        - "milestone"
        - "--watch"
        - "due_date"
        - "--watch"
        - "description"
        - "--watch"
        - "user_notes_count"
        - "--one"                # 1 件を JSON（key・kind・record・before・changes）で出す。無ければ何も出さない
    timeout_sec: 1440            # 要求の上限 × 再試行 + Retry-After の待ち + jitter_sec
    retry_policy:              # 一時的な失敗（終了コード 3）だけ再試行する
      limit: 3
      interval_sec: 60
      exit_code: [3]
    output: CHANGE
  - name: new
    depends: [get]
    preconditions:              # 新しい issue で、開いているもの（${CHANGE.record.*} は issue の項目）
      - condition: "${CHANGE.kind}"
        expected: "appeared"
      - condition: "${CHANGE.record.state}"
        expected: "opened"
    continue_on:
      skipped: true             # 条件に合わなくても commit する
      failure: true             # 失敗しても commit する
    retry_policy:
      limit: 2
      interval_sec: 300
    timeout_sec: 4200
    action: harness.run         # エージェント CLI（Dagu v2 の harness.run。with のほかの項目は CLI のフラグになる）
    working_dir: /home/you/work/project      # エージェントを動かすフォルダ（リポジトリの作業コピー）
    with:
      provider: claude
      prompt: >-
        GitLab に新しい issue #${CHANGE.record.iid}「${CHANGE.record.title}」が作られました。URL: ${CHANGE.record.web_url} 。
        標準入力の JSON（record が issue）を読んで着手し、結果を issue にコメントしてください。
      stdin: "${CHANGE}"
      dangerously_skip_permissions: true     # 権限の確認で止まらないように（無人で動かすため）
  - name: update
    depends: [new]
    preconditions:              # 変わった issue で、開いているもの
      - condition: "${CHANGE.kind}"
        expected: "changed"
      - condition: "${CHANGE.record.state}"
        expected: "opened"
    continue_on:
      skipped: true
      failure: true
    retry_policy:
      limit: 2
      interval_sec: 300
    timeout_sec: 4200
    action: harness.run
    working_dir: /home/you/work/project
    with:
      provider: claude
      prompt: >-
        GitLab の issue #${CHANGE.record.iid}「${CHANGE.record.title}」が変わりました。URL: ${CHANGE.record.web_url} 。
        標準入力の JSON（record が今の issue、before が前回処理したときの issue、changes が変わった項目）を読んで、
        変わったところに対応し、結果を issue にコメントしてください。
      stdin: "${CHANGE}"
      dangerously_skip_permissions: true
  - name: commit
    depends: [update]
    preconditions:              # 受け取った変化があるときだけ
      - condition: "${CHANGE.key}"
        expected: "re:."
    action: exec
    with:
      command: "/home/you/.local/bin/change-watch"
      args:
        - "--config"
        - "/home/you/.config/change-watch/gitlab-issue-agent/change-watch.yaml"
        - "--connections"
        - "/home/you/.github/connections.yaml"
        - "commit"
        - "--source"
        - "gitlab-issues"
        - "--consumer"
        - "issue-agent"
        - "--refresh"            # issue を取り直した姿で記録する（エージェント自身のコメントで次に起きない）
        - "${CHANGE.key}"
    timeout_sec: 600
    retry_policy:
      limit: 3
      interval_sec: 60
      exit_code: [3]
