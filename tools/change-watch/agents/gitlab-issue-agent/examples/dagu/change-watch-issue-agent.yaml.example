# gitlab-issue-agent の Dagu のワークフロー（条件は Dagu が判定し、change-watch は API へのアクセスだけを受け持つ形）。
# ~/.config/dagu/dags/change-watch-issue-agent.yaml をこれに替え、設定も同じフォルダの change-watch.yaml.example に替える。
# 毎分起動し、1 回の起動で 1 件を処理する:
#   get     前回 commit してから変わった issue を 1 件受け取る（GitLab に問い合わせるかは取得元の schedule で change-watch が決める）
#   handle  条件（preconditions）に合えば、エージェント CLI に渡す   ← 条件はここに書く
#   commit  処理し終えたと記録する（issue を取り直した姿で。エージェント自身のコメントで次に起きない）
# handle が失敗しても commit する（Dagu の retry_policy でやり直し、尽きたら失敗として Dagu の履歴に残る）。
# 同じ issue に次の変化があれば、また流れる。
# command は install.py install が置いた change-watch。/home/you を自分の場所に直す（exec は ~ を展開しない）。
# Windows では command を python に、args の先頭を change-watch.pyz のフルパスにする。
description: "GitLab の issue の変化を受け取り、条件に合えばエージェント CLI で 1 件を処理する"
schedule: "* * * * *"
type: graph
hist_retention_days: 14
dotenv:
  - "/home/you/.config/change-watch/gitlab-issue-agent/gitlab-issue-agent.env"
steps:
  - name: get
    action: exec
    with:
      command: "/home/you/.local/bin/change-watch"
      args:
        - "--config"
        - "/home/you/.config/change-watch/gitlab-issue-agent/change-watch.yaml"
        - "--connections"
        - "/home/you/.github/connections.yaml"
        - "get"
        - "--source"
        - "gitlab-issues"
        - "--consumer"
        - "issue-agent"          # commit と同じ名前。ワークフローごとに別の名前にすると、それぞれが全部の変化を受け取る
        - "--watch"              # これらのどれかが変わったときだけ変化にする（updated_at だけの更新では起こさない）
        - "title"
        - "--watch"
        - "state"
        - "--watch"
        - "labels"
        - "--watch"
        - "description"
        - "--watch"
        - "user_notes_count"
        - "--one"                # 1 件を JSON（key・kind・record・before・changes）で出す。無ければ何も出さない
    timeout_sec: 1440            # 要求の上限 × 再試行 + Retry-After の待ち + jitter_sec
    retry_policy:              # 一時的な失敗（終了コード 3）だけ再試行する
      limit: 3
      interval_sec: 60
      exit_code: [3]
    output: CHANGE
  - name: handle
    id: handle
    depends: [get]
    preconditions:              # どの issue をエージェントに渡すか（Dagu の条件。${CHANGE.record.*} は issue の項目）
      - condition: "${CHANGE.kind}"
        expected: "re:^(appeared|changed)$"
      - condition: "${CHANGE.record.state}"
        expected: "opened"
      # - condition: "${CHANGE.record.labels}"   # ラベル agent が付いているものだけ
      #   expected: 're:"agent"'
    continue_on:
      skipped: true             # 条件に合わなくても commit する
      failure: true             # 失敗しても commit する
    retry_policy:
      limit: 2
      interval_sec: 300
    timeout_sec: 4200
    # エージェント CLI の動かし方（Dagu v2 の harness.run）。provider は claude / codex / kiro / copilot / gemini など
    action: harness.run
    working_dir: /home/you/work/project      # エージェントを動かすフォルダ（リポジトリの作業コピー）
    with:
      provider: claude
      prompt: >-
        GitLab の issue #${CHANGE.record.iid}「${CHANGE.record.title}」に変化がありました（${CHANGE.kind}）。
        URL: ${CHANGE.record.web_url} 。標準入力の JSON（record が今の issue、before が前回処理したときの issue、
        changes が変わった項目）を見て対応し、結果を issue にコメントしてください。
      stdin: "${CHANGE}"
      dangerously_skip_permissions: true     # 権限の確認で止まらないように（無人で動かすため）
  - name: commit
    depends: [handle]
    preconditions:              # 受け取った変化があるときだけ
      - condition: "${CHANGE.key}"
        expected: "re:."
    action: exec
    with:
      command: "/home/you/.local/bin/change-watch"
      args:
        - "--config"
        - "/home/you/.config/change-watch/gitlab-issue-agent/change-watch.yaml"
        - "--connections"
        - "/home/you/.github/connections.yaml"
        - "commit"
        - "--source"
        - "gitlab-issues"
        - "--consumer"
        - "issue-agent"
        - "--refresh"
        - "${CHANGE.key}"
    timeout_sec: 600
    retry_policy:
      limit: 3
      interval_sec: 60
      exit_code: [3]
