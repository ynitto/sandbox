# gitlab-idd スキルでイシューを処理させる change-watch の設定（~/.config/change-watch/gitlab-issue-agent/change-watch.yaml をこれに替える）。
# ここに書くのは GitLab への問い合わせ方だけ。どのイシューをどのロールで処理するか（ラベルでの絞り込みと分岐）は、
# Dagu のワークフロー（change-watch-idd.yaml.example）に書く（README の「gitlab-idd スキルと繋ぐ」）。
version: 1
state_dir: ~/.local/state/change-watch/gitlab-issue-agent   # エージェントごとに分ける

sources:
  gitlab-issues:
    # change-watch は GitLab の URL（https://gitlab.example.com）の接続を使う。gitlab-idd は同じ connections.yaml の
    # default（プロジェクトの URL）を使うので、ラベルを分ける（connections.yaml.example）
    connection: gitlab:watch
    request:
      url: "{{ conn.url }}/api/v4/projects/{{ env.GITLAB_PROJECT | urlencode }}/issues"
      headers:
        PRIVATE-TOKEN: "{{ conn.token }}"
      query: { state: opened, scope: all, order_by: updated_at, sort: asc }
    key: iid                   # get --consumer が変化を見分ける key
    pagination: { type: page, size_param: per_page, size: 100 }
    schedule: "*/15 * * * *"   # 15 分ごとの予定（ワークフローは毎分起動。予定の時刻のあとに取得済みなら問い合わせない）
    jitter_sec: 120
    busy_wait_sec: 600
    failure_backoff_sec: 300
    rate_limit: { min_interval_sec: 1, group: gitlab }
    # イシューを 1 件取り直す要求（commit --refresh）。エージェント自身の書き込みを、次の変化にしないため
    item:
      url: "{{ conn.url }}/api/v4/projects/{{ env.GITLAB_PROJECT | urlencode }}/issues/{{ key }}"
