# gitlab-idd スキルと繋ぐときの Dagu のワークフロー（~/.config/dagu/dags/change-watch-idd.yaml にコピーして使う）。
# どのイシューをどのロールで処理するか（ラベルでの絞り込みと分岐）は、ここ（Dagu の preconditions）に書く。change-watch の設定には書かない。
# 毎分起動し、1 回の起動でロールごとに 1 件まで処理する（エージェント CLI は 1 つずつ動く）:
#   get-work        ワーカーとして前回処理してから変わったイシューを 1 件受け取る（consumer: idd-worker）
#   work            status:open / status:needs-rework / status:needs-clarification なら、ワーカーロールで処理する
#   commit-work     見終えたと記録する（どのイシューも。条件に合わなかったものも）
#   absorb-work     work が動いたイシューは、取り直した姿で記録し直す（エージェント自身の書き込みで次に起きない）
#   get-review / review / commit-review / absorb-review   同じ形で、status:review-ready ならレビュアーロールで処理する（consumer: idd-reviewer）
# ロールごとに consumer を分けているので、ワーカーが status:review-ready にするとレビュアーの側にはそれが変化として届き、
# レビュアーが差し戻す（status:needs-rework）とワーカーの側に届く。ロールが変わらない自分の書き込み（質問のコメントなど）では起きない。
# status:in-progress / status:approved / status:done などはどちらの条件にも合わないので流さない（マージは人が行う）。
# 分け方を変えるなら、work・review の preconditions と、同じ条件を書いた absorb-work・absorb-review を直す。
# work・review の provider・working_dir を自分のものに直す。エージェント CLI から gitlab-idd スキルが使えるようにしておく
# （例: Claude Code なら ~/.claude/skills/gitlab-idd）。working_dir はプロジェクトの作業コピー（gitlab-issue-agent.env の
# GITLAB_IDD_LOCAL_REPO に同じフォルダを書くと、gitlab-idd はイシューごとにクローンせず git worktree を足して作業する）。
# command は install.py install が置いた change-watch（exec は ~ を展開しないので、/home/you は自分の場所に直す）。
# Windows では command を python に、args の先頭を change-watch.pyz のフルパスにする（C:/Users/you/AppData/Local/Programs/change-watch/change-watch.pyz）。
description: "GitLab のイシューの変化を受け取り、gitlab-idd のラベルでワーカーとレビュアーに分けて 1 件ずつ処理する"
schedule: "* * * * *"
type: graph
hist_retention_days: 14
dotenv:
  - "/home/you/.config/change-watch/gitlab-issue-agent/gitlab-issue-agent.env"
steps:
  - name: get-work
    action: exec
    with:
      command: "/home/you/.local/bin/change-watch"
      args:
        - "--config"
        - "/home/you/.config/change-watch/gitlab-issue-agent/change-watch.yaml"
        - "--connections"
        - "/home/you/.github/connections.yaml"
        - "get"
        - "--source"
        - "gitlab-issues"
        - "--consumer"
        - "idd-worker"
        - "--watch"
        - "title"
        - "--watch"
        - "labels"
        - "--watch"
        - "assignees[*].username"
        - "--watch"
        - "user_notes_count"
        - "--watch"
        - "description"
        - "--one"
    timeout_sec: 1440
    retry_policy:              # 一時的な失敗（終了コード 3）だけ再試行する
      limit: 3
      interval_sec: 60
      exit_code: [3]
    output: TO_WORK
  - name: work
    depends: [get-work]
    preconditions:              # 条件（Dagu）: ワーカーが受け持つラベルのイシュー
      - condition: "${TO_WORK.kind}"
        expected: "re:^(appeared|changed)$"
      - condition: "${TO_WORK.record.labels}"
        expected: 're:"status:(open|needs-rework|needs-clarification)"'
    continue_on:
      skipped: true
      failure: true             # 失敗しても commit する（Dagu の retry_policy でやり直し、尽きたら失敗として履歴に残る）
    retry_policy:
      limit: 2
      interval_sec: 300
    timeout_sec: 4200           # gitlab-idd のワーカーは実装ループ（最大 5 回）を回すので長めに
    action: harness.run
    working_dir: /home/you/work/project
    with:
      provider: claude
      prompt: >-
        GitLab のイシュー #${TO_WORK.record.iid}「${TO_WORK.record.title}」を、gitlab-idd スキルのワーカーロールで処理してください。
        URL: ${TO_WORK.record.web_url} 。標準入力の JSON は、record が今のイシュー、before が前回処理したときのイシュー、changes が変わった項目です。
        このイシュー #${TO_WORK.record.iid} だけを処理し、候補の一覧から別のイシューを選ばないでください。
        着手・レビューできない状態（依存イシューが未完了・別のノードが着手中など）なら、理由を 1 行出して何もせずに終えてください。
        接続は connections.yaml の default（--label-conn default）を使い、結果はイシューのラベルとコメントで残してください（gitlab-idd の手順どおり）。
      stdin: "${TO_WORK}"
      dangerously_skip_permissions: true     # 無人で動かすため
  - name: commit-work
    depends: [work]
    preconditions:              # 受け取った変化があるときだけ
      - condition: "${TO_WORK.key}"
        expected: "re:."
    continue_on:
      skipped: true
    action: exec
    with:
      command: "/home/you/.local/bin/change-watch"
      args:
        - "--config"
        - "/home/you/.config/change-watch/gitlab-issue-agent/change-watch.yaml"
        - "--connections"
        - "/home/you/.github/connections.yaml"
        - "commit"
        - "--source"
        - "gitlab-issues"
        - "--consumer"
        - "idd-worker"
        - "${TO_WORK.key}"
    timeout_sec: 600
    retry_policy:
      limit: 3
      interval_sec: 60
      exit_code: [3]
  - name: absorb-work
    depends: [commit-work]
    preconditions:              # work と同じ条件（work が動いたときだけ）
      - condition: "${TO_WORK.kind}"
        expected: "re:^(appeared|changed)$"
      - condition: "${TO_WORK.record.labels}"
        expected: 're:"status:(open|needs-rework|needs-clarification)"'
    continue_on:
      skipped: true
    action: exec
    with:
      command: "/home/you/.local/bin/change-watch"
      args:
        - "--config"
        - "/home/you/.config/change-watch/gitlab-issue-agent/change-watch.yaml"
        - "--connections"
        - "/home/you/.github/connections.yaml"
        - "commit"
        - "--source"
        - "gitlab-issues"
        - "--consumer"
        - "idd-worker"
        - "--refresh"            # エージェントが書いた後の姿を基準にする（自分の書き込みで次に起きない）
        - "${TO_WORK.key}"
    timeout_sec: 600
    retry_policy:
      limit: 3
      interval_sec: 60
      exit_code: [3]
  - name: get-review
    depends: [absorb-work]
    action: exec
    with:
      command: "/home/you/.local/bin/change-watch"
      args:
        - "--config"
        - "/home/you/.config/change-watch/gitlab-issue-agent/change-watch.yaml"
        - "--connections"
        - "/home/you/.github/connections.yaml"
        - "get"
        - "--source"
        - "gitlab-issues"
        - "--consumer"
        - "idd-reviewer"
        - "--watch"
        - "title"
        - "--watch"
        - "labels"
        - "--watch"
        - "assignees[*].username"
        - "--watch"
        - "user_notes_count"
        - "--watch"
        - "description"
        - "--one"
    timeout_sec: 1440
    retry_policy:              # 一時的な失敗（終了コード 3）だけ再試行する
      limit: 3
      interval_sec: 60
      exit_code: [3]
    output: TO_REVIEW
  - name: review
    depends: [get-review]
    preconditions:              # 条件（Dagu）: レビューを待つイシュー
      - condition: "${TO_REVIEW.kind}"
        expected: "re:^(appeared|changed)$"
      - condition: "${TO_REVIEW.record.labels}"
        expected: 're:"status:(review-ready)"'
    continue_on:
      skipped: true
      failure: true             # 失敗しても commit する（Dagu の retry_policy でやり直し、尽きたら失敗として履歴に残る）
    retry_policy:
      limit: 2
      interval_sec: 300
    timeout_sec: 4200           # gitlab-idd のワーカーは実装ループ（最大 5 回）を回すので長めに
    action: harness.run
    working_dir: /home/you/work/project
    with:
      provider: claude
      prompt: >-
        GitLab のイシュー #${TO_REVIEW.record.iid}「${TO_REVIEW.record.title}」を、gitlab-idd スキルのレビュアーロールで処理してください。
        URL: ${TO_REVIEW.record.web_url} 。標準入力の JSON は、record が今のイシュー、before が前回処理したときのイシュー、changes が変わった項目です。
        このイシュー #${TO_REVIEW.record.iid} だけを処理し、候補の一覧から別のイシューを選ばないでください。
        着手・レビューできない状態（依存イシューが未完了・別のノードが着手中など）なら、理由を 1 行出して何もせずに終えてください。
        接続は connections.yaml の default（--label-conn default）を使い、結果はイシューのラベルとコメントで残してください（gitlab-idd の手順どおり）。
      stdin: "${TO_REVIEW}"
      dangerously_skip_permissions: true     # 無人で動かすため
  - name: commit-review
    depends: [review]
    preconditions:
      - condition: "${TO_REVIEW.key}"
        expected: "re:."
    continue_on:
      skipped: true
    action: exec
    with:
      command: "/home/you/.local/bin/change-watch"
      args:
        - "--config"
        - "/home/you/.config/change-watch/gitlab-issue-agent/change-watch.yaml"
        - "--connections"
        - "/home/you/.github/connections.yaml"
        - "commit"
        - "--source"
        - "gitlab-issues"
        - "--consumer"
        - "idd-reviewer"
        - "${TO_REVIEW.key}"
    timeout_sec: 600
    retry_policy:
      limit: 3
      interval_sec: 60
      exit_code: [3]
  - name: absorb-review
    depends: [commit-review]
    preconditions:              # review と同じ条件
      - condition: "${TO_REVIEW.kind}"
        expected: "re:^(appeared|changed)$"
      - condition: "${TO_REVIEW.record.labels}"
        expected: 're:"status:(review-ready)"'
    continue_on:
      skipped: true
    action: exec
    with:
      command: "/home/you/.local/bin/change-watch"
      args:
        - "--config"
        - "/home/you/.config/change-watch/gitlab-issue-agent/change-watch.yaml"
        - "--connections"
        - "/home/you/.github/connections.yaml"
        - "commit"
        - "--source"
        - "gitlab-issues"
        - "--consumer"
        - "idd-reviewer"
        - "--refresh"            # エージェントが書いた後の姿を基準にする（自分の書き込みで次に起きない）
        - "${TO_REVIEW.key}"
    timeout_sec: 600
    retry_policy:
      limit: 3
      interval_sec: 60
      exit_code: [3]
