# インストーラは ~/.config/change-watch/gitlab-decision-stagnation-agent/env に配置する。
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxx
GITLAB_PROJECTS=group/project,group/another-project
GITLAB_HUB_ISSUE_URL=https://gitlab.example.com/ops/hub/-/issues/42
DECISION_STAGNATION_LABELS=decision,needs-decision,needs,approval
DECISION_STAGNATION_PACKET_LABELS=decision-packet,status:review-ready
DECISION_STAGNATION_THRESHOLD_DAYS=7
DECISION_STAGNATION_DRY_RUN=1
