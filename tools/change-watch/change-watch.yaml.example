# change-watch の設定の例。~/.config/change-watch/change-watch.yaml などにコピーして使う。
# ここに書くのは API への問い合わせ方だけ（取得元）。どのレコードをどう処理するか（条件）は Dagu のワークフローに書き、
# ワークフローの各ステップが change-watch get / commit / call を呼ぶ（例: dags/change-watch-get.example.yaml）。
# 条件も change-watch に任せる（ルールを書く）形は change-watch.rules.yaml.example。
# 認証情報はここに書かず、connections.yaml（スキル共通の接続設定）に書き、そのパスを実行時に渡す:
#   change-watch --config ~/.config/change-watch/change-watch.yaml --connections ~/.github/connections.yaml get --source gitlab-issues

version: 1
state_dir: ~/.local/state/change-watch     # 状態（SQLite）の置き場所

retention:
  fetches_keep: 3        # 取得結果を最低何回分残すか
  fetch_days: 7          # これより古い取得結果は消す

sources:
  # GitLab の issue（ページ番号のページング・更新日時による増分取得）
  gitlab-issues:
    connection: gitlab               # connections.yaml の gitlab / default
    request:
      url: "{{ conn.url }}/api/v4/projects/123/issues"
      headers:
        PRIVATE-TOKEN: "{{ conn.token }}"
      query:
        state: all
        order_by: updated_at
        sort: asc
    records: "$"
    key: iid                         # get --consumer が変化を見分ける key（増分取得では全体の姿の組み立てにも使う）
    pagination:
      type: page
      param: page
      size_param: per_page
      size: 100
    incremental:
      type: max_value
      field: updated_at              # 取得したレコードの updated_at の最大を覚え、
      param: updated_after           # 次回は updated_after=<その値> を付けて取る
    schedule: "*/10 * * * *"         # 問い合わせの予定。ワークフローが毎分 get しても、予定の時刻ごとに 1 回だけ問い合わせる
    jitter_sec: 120                  # 予定の時刻から 0〜2 分ずらす（定刻に API へ集中させない）
    busy_wait_sec: 300               # 別のワークフローが取得中なら、終わるのを待ってその結果を使う
    rate_limit:
      min_interval_sec: 0.5
      group: gitlab                  # 同じ GitLab を見るほかの取得元と、要求の間隔・失敗の待ちを分け合う
    retry:
      attempts: 4
      backoff_sec: 2
    # issue を 1 件取り直す要求（commit --refresh。処理の中で自分が書き込んだ分を、次の変化にしない）
    item:
      url: "{{ conn.url }}/api/v4/projects/123/issues/{{ key }}"

  # 一般的な JSON API（カーソルのページング・POST の検索）
  tickets:
    connection: myapi:default
    request:
      method: POST
      url: "{{ conn.url }}/v1/tickets/search"
      headers:
        Authorization: "Bearer {{ conn.api_key }}"
      body:
        filter: { project: "OPS" }
        limit: 50
    records: results
    key: id
    pagination:
      type: cursor
      in: body                       # カーソルを body の cursor に入れる
      param: cursor
      cursor_path: next_cursor
      has_more_path: has_more
    schedule: "*/5 * * * *"
    min_interval_sec: 60
