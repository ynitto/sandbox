# agent-loop の設定ファイルサンプル
# ファイル名: agent-loop.yaml
#
# 共通設定として使う場合は ~/.agents/agent-loop.yaml、プロジェクト固有の prompts として
# 使う場合は <project>/.agents/agent-loop.yml へ置きます（旧 .agent は読み取り互換）。

# 設定内の prompt / cwd などから `{{lookup <ラベル> <キー>}}` で参照できる。
# mapping:
#   workspace:
#     main: /path/to/workspace
#   message:
#     review: 直近の変更をレビューしてください

# ---------------------------------------------------------------------------
# エージェント間メッセージング設定
# ---------------------------------------------------------------------------
# agent_name: orchestrator  # このデーモンのエージェント識別名。
#                           # 設定すると ~/.kiro/agents/<name>/inbox/ を監視し
#                           # 受信メッセージを kiro-cli へプロンプトとして送信する。
#                           # 省略時は受信機能なし（送信のみ可）。
# inbox_poll_seconds: 5     # 受信ボックスのポーリング間隔（秒）。デフォルト 5。


# ---------------------------------------------------------------------------
# inbound webhook（provider 非依存）
# ---------------------------------------------------------------------------
# agent-loop 稼働中だけ HTTP サーバを常駐させ、外部システム（GitLab 等）の webhook を
# `POST <path_prefix>/<name>` で受ける。<name> は下の prompts エントリ名に対応し、
# 受信 payload は hook でパースしてエントリの prompt テンプレートへ注入される。
# コアは送信元を知らない（イベント判定・署名検証・payload 構造は hook 側の責務）。
# webhook:
#   enabled: true
#   host: 127.0.0.1              # 既定 localhost。公開時はリバースプロキシ/トンネル経由を推奨
#   port: 8899                   # 必須。複数 agent-loop を動かす場合はインスタンスごとに変える
#   path_prefix: /hooks          # 既定 /hooks
#   secret: ""                   # 汎用共有シークレット。空なら検証せず起動時 WARNING
#   secret_header: X-Gitlab-Token  # secret を照合するヘッダ名（provider で可変）
#   max_body_bytes: 1048576      # ボディ上限（既定 1MB）。超過は 413


# ---------------------------------------------------------------------------
# エージェント CLI の差し替え（agents/<name>.json 契約）
# ---------------------------------------------------------------------------
# 省略時は従来どおり kiro-cli（下の kiro_options）。指定すると agents/<name>.json の
# interactive 定義から起動 argv と待機判定（ready_pattern / busy_pattern /
# idle_quiet_sec / clear_command）を解決してペインを駆動する。
# 未知・壊れた定義は起動エラー（黙って kiro へ倒さない）。
# 注意: kiro 以外では slot-release stop hook（agent-loop-concurrency agent）は
# 注入されず、スロット解放は SlotMonitor のペイン監視だけで行う。
# agent_cli: claude
# agent_cli_options:
#   model: claude-sonnet-5   # 定義の {model} / model_flag に渡す（省略可）
#   readonly: false          # 読み取り専用フラグで起動する（既定 false）
#   extra_args: []           # 定義の argv 末尾に足す追加フラグ

# ---------------------------------------------------------------------------
# environment handoff（Phase 2C — opt-in）
# ---------------------------------------------------------------------------
# ペイン起動時に HOME / AGENT_HOME / agent 定義 env を明示し、必要なら root prompt
# 先頭へ [ENV]...[/ENV] を付ける（Ralph child には付けない）。token 値は含めない。
# environment_handoff:
#   prompt: false
#   skill_home: null
#   token_env_names: []

# agent-tuning: ~/.agents/tuning/tuning.json の profile をプロンプト単位で選ぶ。
# 外向き成果物には tuning_profile: external-facing を指定する（注入なし）。

# ---------------------------------------------------------------------------
# kiro-cli の起動オプション（全ワークスペース共通・agent_cli 未指定時のみ）
# ---------------------------------------------------------------------------
kiro_options:
  trust_all_tools: true    # ツール使用の確認をスキップ（推奨: true）
  resume: false            # 直前のセッションを引き継ぐ
  # agent: my-agent        # エージェントを指定（省略可）
  # model: claude-sonnet   # モデルを指定（省略可）
  # extra_args:
  #   - "--some-option"

# ---------------------------------------------------------------------------
# タイムアウト設定（秒）
# ---------------------------------------------------------------------------
startup_timeout: 60        # kiro-cli 起動待ち上限

# ---------------------------------------------------------------------------
# ヘルス監視（Phase 1 — opt-in。0 / false = 無効）
# ---------------------------------------------------------------------------
# health:
#   check_interval_seconds: 10
#   freeze_timeout_seconds: 0   # busy 中の画面 hash が変化しない場合の freeze 検知（秒）
#   max_pane_rss_mb: 0          # ready pane の RSS 上限（MB）
#   min_free_memory_mb: 0      # 空きメモリ下限（MB）。下回ると local pause（2 回連続 OK で自動 resume）
#   input_recovery: false      # ready + 入力残留時に 1 回だけ再送
#
# local pause / 操作:
#   agent-loop pause|resume|cancel TARGET|drain|reload
#   pause は ~/.agents/loop-control/ に永続。resume は local pause のみ解除。

# ---------------------------------------------------------------------------
# 同時実行数制御（複数 agent-loop プロセス間で共有）
# ---------------------------------------------------------------------------
max_concurrent: 3             # kiro-cli の最大同時実行タスク数（0 = 無制限、デフォルト）
slot_timeout_seconds: 7200    # スロット強制解放までの猶予時間（秒）。デフォルト 7200 = 2時間。
                              # hook・ペイン監視が両方失敗した場合のフォールバックタイムアウト。
cooldown_seconds: 30          # セマフォ解放後の再取得待機時間（秒）。デフォルト 0 = 無効。
                              # 設定すると、一度実行したペインは指定秒数の間セマフォを取得できず、
                              # 他のペインに実行機会が回るようになる（公平性の確保）。

# ---------------------------------------------------------------------------
# Phase 2A: external pane（既存 tmux へ送る。起動・cleanup・cancel しない）
# ---------------------------------------------------------------------------
# external_panes:
#   - name: existing-reviewer
#     tmux_target: review:0.1
#     agent_cli: codex          # optional。未指定は daemon 既定 profile

# ---------------------------------------------------------------------------
# 定期プロンプトの定義
# ---------------------------------------------------------------------------
prompts:
  # ---- MR コメント返答: 自分担当 MR の未解決スレッドを拾って返答・修正 ----
  # レビュアーが MR にコメントを投稿した後、このプロンプトが返答または修正を行う
  - name: "MR コメント返答"
    prompt: |
      自分にアサインされたオープン MR の未解決ディスカッションを確認してください。
      手順:
      1. python scripts/gl.py list-mrs --state opened でオープン MR を取得
      2. 自分が assignee の MR に対して python scripts/gl.py get-mr-discussions MR_IID --unresolved で未解決スレッドを取得
      3. 各スレッドの指摘内容を確認し:
         - 質問・説明要求 → python scripts/gl.py add-mr-comment MR_IID --body "返答内容" で返答し、python scripts/gl.py resolve-mr-discussion MR_IID DISCUSSION_ID でスレッドをクローズ
         - コード修正要求 → 修正を実装して push し、python scripts/gl.py add-mr-comment MR_IID --body "修正しました: ..." で報告してスレッドをクローズ
      4. 全スレッドがクローズしたら python scripts/gl.py add-mr-comment MR_IID --body "全指摘に対応しました。再レビューをお願いします。" を投稿
      未解決スレッドがなければ「対応待ちのコメントはありません」と報告して終了。
    interval_minutes: 60   # 1 時間ごとに確認
    # adaptive:                 # cron 以外で有効。enabled: true が必須（暗黙有効にしない）
    #   enabled: true
    #   min_interval_seconds: 60
    #   max_interval_seconds: 1800
    #   backoff_factor: 1.5
    #   idle_threshold: 3
    #   jitter: 0.2
    # preflight: ~/hooks/should_dispatch.py  # should_dispatch(request, cfg)->bool。例外/timeout は fail-open
    enabled: true

  # ---- GitLab Issue ワーカー: 自分にアサインされた Issue を拾って実行 ----
  - name: "GitLab Issue ワーカー"
    prompt: |
      gitlab-idd スキルのワーカーロールを実行してください。
      自分にアサインされた status:open の Issue を 1 件取得して実装・報告してください。
    interval_minutes: 60
    cron: "0 9 * * 1-5"      # 平日9:00
    cwd: /path/to/workspace  # ワークスペースを指定
    enabled: true

  # ---- slash: 本文の前にスラッシュコマンドを送る ----
  # 設計: docs/designs/agent-loop-design.md（機能 6）
  # 送信文の前に `/<name> [args]` を **1 行ずつ独立に**送る（連結しない。対話 CLI は
  # スラッシュコマンドを「1 入力 = 1 コマンド」で解釈するため）。
  # 送信順は fresh_context の /clear → slash（宣言順）→ prompt 本文。
  # スキル呼び出しに限らず、対話 CLI が受けるコマンドなら何でも書ける。
  - name: "ログ要約"
    slash: summarize-logs        # 文字列 1 本（先頭の / は書かない）
    prompt: "昨日のログを要約して"
    interval_minutes: 60
    enabled: false

  - name: "定期点検"
    slash: ["healthcheck", "report --lang ja"]   # 配列・引数付きも可
    prompt: "結果を 3 行で"
    interval_minutes: 240
    enabled: false

  - name: "コンテキスト整理だけ"
    slash: compact               # prompt を省いた slash 単独も有効
    interval_minutes: 120
    enabled: false

  # ---- hooks: 送信タイミングと内容を Python スクリプトで制御する ----
  # hooks は文字列または配列。スケジュール発火のたびに各フックの check() が呼ばれる:
  #   - str を返す  → そのテキストを prompt として送信（YAML の prompt を上書き）
  #   - None を返す → 今回は送信せずスキップ
  # hooks を使う場合 prompt は省略可（フックが内容を決める）。名前だけを指定すると
  # install.sh が配置した hooks/ を探索する（拡張子 .py は省略可）。
  #
  # event_hook_fallback: true にすると、フックに環境変数
  #   AGENT_LOOP_EVENT_HOOK_FALLBACK=1 が渡される。フック側はこれを見て
  #   「更新が無いときでもフィルター条件に合致する対象をランダムに 1 件選んで
  #   送信する（フォールバック）」挙動を実装できる。デフォルト false（更新が
  #   無ければ何も送らない）。フォールバックは check() の呼び出しごとに評価される。
  # 同梱フック例:
  #   hooks/gitlab-issue-hook.py … 新規/更新 Issue を検知。更新が無ければ
  #                                 フォールバックでランダムな Issue を送る。
  #   hooks/gitlab-mr-hook.py    … 新規/更新 MR を検知。更新が無ければ
  #                                 フォールバックでランダムな MR を送る。
  - name: "GitLab Issue ワーカー (hooks)"
    hooks: gitlab-issue-hook
    event_hook_fallback: true   # 更新が無くてもランダムに 1 件送る
    interval_minutes: 5
    cwd: /path/to/workspace
    enabled: false

  # dashboard を開かずに CLI quota を収集し、node-budget の再配分と
  # profile の候補切替・降格/復帰を適用する。どちらも LLM は使わない。
  - name: "資源制御"
    hooks: resource-control-hook
    interval_minutes: 5
    enabled: false

  # 収集済みの実測を rates.per_cli へ定期較正し、旧推定との乖離も audit 台帳へ残す。
  - name: "使用量較正"
    hooks: audit-calibrate-hook
    interval_minutes: 60
    enabled: false

  # 記憶の整理のうち LLM が要らない分（索引再構築・忘却曲線の更新・wiki lint・
  # memory-store の収集）を人手ゼロで回す。削除は絶対に走らせない。
  - name: "記憶メンテナンス"
    hooks: memory-maintenance-hook
    hook_config:
      skill_home: ~/.claude/skills   # ltm-use / wiki-use のスクリプトを探す親
      ltm_scopes: [home]
    interval_minutes: 360
    enabled: false

  # 判断の要る整理（consolidate の実行判断・persona 観察ログの反映・wiki の重複統合）を
  # 当番として回す。材料は knowledge 集計で、**dry-run を先に見てから適用**する。
  # 削除（cleanup_memory.py）は自律実行せず、dry-run の結果を要対応として投函し、
  # 承認された分だけを次回の当番が実行する。
  - name: "記憶メンテナンス当番"
    prompt: |
      `agent-audit report --kind knowledge` を実行し、出力を材料に記憶層を整えてください。
      1. 類似クラスタが出ている ltm のカテゴリは `consolidate_memory.py --category <名> --dry-run`
         を先に実行し、結果が妥当なら `--yes` で適用する（consolidate は非破壊）。
      2. persona の未反映の観察ログがあれば `batch_update_persona.py` で管理ファイルへ反映する。
      3. wiki の index 乖離・リンク切れは wiki-use の手順で統合・alias 付与を行う。
      4. 退役候補は `cleanup_memory.py --dry-run` の出力を要対応として投函するだけにし、
         **削除は実行しない**。承認済みのものだけを実行する。
      レイヤ取り違えが疑わしいものは移送せず、根拠とともに報告する。
    acceptance:
      - "`agent-audit report --kind knowledge` の出力を材料にしている"
      - 削除（cleanup_memory.py の実行）を行っていない
      - consolidate は dry-run の確認後にだけ適用している
    tuning_profile: default
    interval_minutes: 1440
    enabled: false

  # 空き時間の Moltbook 運転のうち LLM が要らない分（outbox の publish backlog を
  # privacy gate に通す sweep・人が承認した返信下書きの送信）を人手ゼロで回す。
  # 新しい判断はしない——publish は既に置かれた候補を gate に通すだけ、
  # reply-drafts は drafts/approved/ へ人が移した分だけを送る。
  - name: "Moltbook 巡回"
    hooks: moltbook-duty-hook
    hook_config:
      skill_home: ~/.claude/skills
      label_conn: default
    interval_minutes: 30
    # adaptive で「暇なときだけ、財布の内側で」を既存機構だけで成立させる（新設しない）。
    # adaptive:
    #   enabled: true
    #   min_interval_seconds: 300
    #   max_interval_seconds: 3600
    #   backoff_factor: 1.5
    #   idle_threshold: 3
    enabled: false

  # 未回答質問の確認・根拠つき返信・good の判断（LLM が要る分）を回す当番。
  # reply --autonomous は moltbook.py 側の単一ゲート（reply_mode/予算/深さ/
  # クールダウン）をそのまま通る。quiet 運転のノードでは自律返信が自動的に
  # 下書きへ落ちるので、このプロンプト自体は active/quiet を意識しなくてよい。
  - name: "Moltbook 当番"
    prompt: |
      moltbook-use の timeline で自分宛て新着と未回答質問を確認してください。
      各未回答質問について recall_memory.py / wiki_query.py で根拠が自層から
      引けたものだけ、moltbook.py reply --iid <iid> --body "..." --autonomous
      で返信してください（根拠が無ければ書かない。生成だけで答えない）。
      役立った投稿には moltbook.py good --iid <iid> を付けてください。
      publish バックログの sweep と承認済み下書きの送信は別の巡回が行うので、
      ここでは timeline の確認・根拠つき reply・good の判断だけを行ってください。
    acceptance:
      - timeline の確認結果を踏まえている
      - 返信した質問には自層（ltm/wiki）から引けた根拠を示している
    tuning_profile: default
    interval_minutes: 60
    enabled: false

  # ---- webhook: GitLab の MR webhook を受けてこのセッションに送る ----
  # 上部の webhook: セクションを有効化した上で、GitLab のプロジェクト設定で
  #   URL      = http://<host>:<port>/hooks/mr-reviewer
  #   Secret   = webhook.secret と同じ値（X-Gitlab-Token として送られる）
  # を登録する。interval/cron を書かなければ push 駆動のみ（自動発火しない）。
  # 送信元固有の判定・パースは hook 側（hooks/gitlab-mr-webhook.py）が行う。
  - name: mr-reviewer
    prompt: |
      [MR webhook] {project} !{mr_iid}（{action}）
      タイトル: {title}
      {source_branch} → {target_branch}
      URL: {url}
      この MR をレビューして、指摘があれば MR にコメントしてください。
    webhook:
      hook: ~/sandbox/tools/agent-loop/hooks/gitlab-mr-webhook.py
    enabled: false

  # ---- Kanban 更新: GitLab → Obsidian kanban.md を再生成 ----
  # terminal-launcher や cron で直接 sync.py --kanban を呼ぶ場合は不要
  - name: "Kanban 同期"
    prompt: |
      以下のコマンドを実行して Obsidian の kanban.md を最新状態に更新してください。
      python ~/sandbox/tools/gitlab-obsidian-sync/sync.py --kanban --config ~/gitlab-obsidian-sync.yaml
    interval_minutes: 30
    enabled: true

  # ---- サンプル: 固定プロンプトによる定期コードレビュー ----
  - name: "定期コードレビュー"
    prompt: |
      直近の変更内容を確認して、問題があれば報告してください。
    interval_minutes: 30
    exclude_from_concurrency: true   # このプロンプトは max_concurrent の制限対象外にする
                                     # 軽量な確認タスクや緊急タスクに有用
    enabled: false                   # 一時的に無効化する

  # ---- Phase 2A: Ralph（N 回の work iteration。最終回に要約指示）----
  # - name: "Nightly refactor"
  #   mode: ralph
  #   max_iterations: 5              # 必須・1..100。別枠 finalize は無い
  #   prompt: "対象を調査し、改善を実装してください"
  #   interval_minutes: 1440
  #   enabled: false

  # ---- Phase 2A: oneshot（都度 ephemeral pane。clean_session と併用不可）----
  # - name: "Isolated review"
  #   oneshot: true
  #   prompt: "現在の差分をレビューしてください"
  #   interval_minutes: 60
  #   enabled: false

  # ---- Phase 2A: clean_session（N 件 DONE 後に save→clear→exit→pane 破棄）----
  # - name: "long-running-worker"
  #   clean_session: 10
  #   prompt: "キューを1件処理してください"
  #   interval_minutes: 10
  #   enabled: false

  # ---- Phase 2A: external pane へ配送 ----
  # - name: "external-review"
  #   target: existing-reviewer      # external_panes.name
  #   prompt: "現在の差分をレビューしてください"
  #   interval_minutes: 60
  #   enabled: false
