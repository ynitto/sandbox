# gitlab-idd スキルと繋ぐときの Dagu のワークフロー（~/.config/dagu/dags/api-watch-idd.yaml にコピーして使う）。
# 毎分起動し、1 回の起動で 1 件を処理する: fetch → evaluate → claim → render（ラベルからロールを選んだプロンプト）→ handle → finish。
# handle の provider・working_dir を自分のものに直す。
# command は install.py install が置いた api-watch（exec は ~ を展開しないので、/home/you は自分の場所に直す）。
# Windows なら command を python に、args の先頭を C:/Users/you/AppData/Local/Programs/api-watch/api-watch.pyz にする。
description: "gitlab-issues を取得し、ルール idd で判定して、gitlab-idd スキルで 1 件を処理する"
schedule: "* * * * *"
type: graph
hist_retention_days: 14
dotenv:
  - "/home/you/.config/dagu/gitlab-issue-agent.env"
steps:
  - name: fetch
    action: exec
    with:
      command: "/home/you/.local/bin/api-watch"
      args:
        - "--plugin"
        - "dagu"
        - "--plugin"
        - "/home/you/.local/share/gitlab-issue-agent/gitlab_issue.py"
        - "--connections"
        - "/home/you/.github/connections.yaml"
        - "fetch"
        - "--source"
        - "gitlab-issues"
    timeout_sec: 1440            # 要求の上限 × 再試行 + Retry-After の待ち + jitter_sec
    retry_policy:              # 一時的な失敗（終了コード 3）だけ再試行する
      limit: 3
      interval_sec: 60
      backoff: true
      max_interval_sec: 600
      exit_code: [3]
  - name: evaluate
    depends: [fetch]
    action: exec
    with:
      command: "/home/you/.local/bin/api-watch"
      args:
        - "--plugin"
        - "dagu"
        - "--plugin"
        - "/home/you/.local/share/gitlab-issue-agent/gitlab_issue.py"
        - "--connections"
        - "/home/you/.github/connections.yaml"
        - "evaluate"
        - "--rule"
        - "idd"
    timeout_sec: 600
    retry_policy:
      limit: 2
      interval_sec: 10
  - name: claim
    depends: [evaluate]
    action: exec
    with:
      command: "/home/you/.local/bin/api-watch"
      args:
        - "--plugin"
        - "dagu"
        - "--plugin"
        - "/home/you/.local/share/gitlab-issue-agent/gitlab_issue.py"
        - "--connections"
        - "/home/you/.github/connections.yaml"
        - "claim"
        - "--rule"
        - "idd"
        - "--target"
        - "run"
    timeout_sec: 600
    output: DELIVERY
  - name: render
    depends: [claim]
    action: exec
    with:
      command: "/home/you/.local/bin/api-watch"
      args:
        - "--plugin"
        - "dagu"
        - "--plugin"
        - "/home/you/.local/share/gitlab-issue-agent/gitlab_issue.py"
        - "--connections"
        - "/home/you/.github/connections.yaml"
        - "render"
        - "${DELIVERY}"
    timeout_sec: 300
    preconditions:              # 取れた受け渡しがあるときだけ（ID は aw_ で始まる）
      - condition: "${DELIVERY}"
        expected: "re:^aw_"
    output: INPUT
  - name: handle
    id: handle
    depends: [render]
    preconditions:              # 取れた受け渡しがあるときだけ（ID は aw_ で始まる）
      - condition: "${DELIVERY}"
        expected: "re:^aw_"
    timeout_sec: 4200             # api-watch の設定の timeout_sec と同じにする
    continue_on:                # 失敗・時間切れでも finish で記録する
      failure: true
    # エージェント CLI から gitlab-idd スキルが使えるようにしておく（例: Claude Code なら ~/.claude/skills/gitlab-idd）。
    # working_dir はプロジェクトの作業コピー（gitlab-idd はそこから git remote を読み、作業用のクローンを自分で作る）。
    action: harness.run
    working_dir: /home/you/work/project
    with:
      provider: claude
      prompt: GitLab のイシューに変化がありました。標準入力の指示に従って、gitlab-idd スキルで処理してください。
      stdin: "${INPUT}"
      dangerously_skip_permissions: true     # 無人で動かすため
  - name: finish
    depends: [handle]
    action: exec
    with:
      command: "/home/you/.local/bin/api-watch"
      args:
        - "--plugin"
        - "dagu"
        - "--plugin"
        - "/home/you/.local/share/gitlab-issue-agent/gitlab_issue.py"
        - "--connections"
        - "/home/you/.github/connections.yaml"
        - "finish"
        - "${DELIVERY}"
        - "--exit-code"
        - "${handle.exit_code}"
    timeout_sec: 600
    preconditions:              # 取れた受け渡しがあるときだけ（ID は aw_ で始まる）
      - condition: "${DELIVERY}"
        expected: "re:^aw_"
