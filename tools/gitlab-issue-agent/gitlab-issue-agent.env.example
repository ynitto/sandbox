# gitlab-issue-agent の設定（~/.config/dagu/gitlab-issue-agent.env にコピーして使う）。
# Dagu のワークフローがこのファイルを読み込み（ワークフローの dotenv）、api-watch の設定と接続設定がここから値を取る。

GITLAB_URL=https://gitlab.example.com
GITLAB_PROJECT=group/project
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxx

# --- gitlab-idd スキルと繋ぐとき（README の「gitlab-idd スキルと繋ぐ」）---
# エージェントが動かす gitlab-idd に、api-watch と同じ接続設定を読ませる（connections.yaml の default を使う）
# SKILL_CONNECTIONS_FILE=/home/you/.github/connections.yaml
# このワークフローのエージェントを gitlab-idd の 1 つのノードとして識別する名前
# GITLAB_NODE_ID=gitlab-issue-agent

# 取得の予定・ずらし・再試行・絞り込み・実行の上限は api-watch の設定（api-watch.yaml）に、
# エージェント CLI の種類・フラグ・作業フォルダはワークフローの handle のステップ（api-watch-issue-agent.yaml）に書く
