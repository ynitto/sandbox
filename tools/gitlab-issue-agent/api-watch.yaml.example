# gitlab-issue-agent の api-watch の設定（~/.config/api-watch/api-watch.yaml にコピーして使う）。
#
# Dagu のワークフロー 1 本（api-watch-issue-agent。api-watch の dags で作る）で動く。毎分起動し、1 回の起動で 1 件を処理する:
#   fetch → evaluate → claim（実行できる issue を 1 件取る。取り直し・飛ばす判定）→ render（プロンプト）
#   → handle（エージェント CLI。Dagu の harness.run）→ finish（処理し終えた状態の記録。失敗ならあとでやり直す）
# GitLab の issue に固有の部分（プロンプトの差分・実行中の他人の動き）は gitlab_issue.py（api-watch のプラグイン）が受け持つ。
# api-watch を呼ぶときは毎回 --plugin <gitlab_issue.py のパス> を付ける（dags も付けた引数を DAG に書く）。
#
#   api-watch --plugin dagu --plugin ~/.local/share/gitlab-issue-agent/gitlab_issue.py \
#     --config ~/.config/api-watch/api-watch.yaml --connections ~/.github/connections.yaml \
#     dags --out ~/.config/dagu/dags --dotenv ~/.config/dagu/gitlab-issue-agent.env \
#     --handle-step issue-agent.run=~/.config/dagu/gitlab-issue-agent.handle.yaml
#
# GitLab にいつ問い合わせるかは、下の取得元の schedule を見て api-watch が決める（Dagu のワークフローは毎分起動するだけ）。
# 問い合わせの予定も Dagu に任せたいなら、取得元の schedule を消し、dags --schedule "0 * * * *" のように Dagu の起動間隔で決める
# （そのときは min_interval_sec を書いておくと、手で叩いたときや別のワークフローとの重複を防げる）。
#
# GitLab の URL・プロジェクト・トークンは ~/.config/dagu/gitlab-issue-agent.env にだけ書く。
# connections.yaml の gitlab は次のように書き、値はその環境変数から取る:
#
#   gitlab:
#     - label: default
#       url: ${GITLAB_URL}
#       token: ${GITLAB_TOKEN}
version: 1
state_dir: ~/.local/state/api-watch

sources:
  gitlab-issues:
    connection: gitlab
    request:
      url: "{{ conn.url }}/api/v4/projects/{{ env.GITLAB_PROJECT | urlencode }}/issues"
      headers:
        PRIVATE-TOKEN: "{{ conn.token }}"
      # 取得する issue を絞る（labels: agent や assignee_username: bot-user も足せる）。実行の直前の確かめは下のルールの filter
      query: { state: opened, scope: all, order_by: updated_at, sort: asc }
    key: iid
    pagination: { type: page, size_param: per_page, size: 100 }
    # GitLab に問い合わせる予定（この PC の時刻）。ワークフローが毎分起動しても、予定の時刻のあとに一度取得し終えたら、
    # 次の予定の時刻までは取得しない。この取得元を使うワークフローがいくつあっても、予定の時刻ごとに 1 回にまとまる
    schedule: "0 * * * *"
    jitter_sec: 900            # 予定の時刻から 0〜15 分ずらして問い合わせる（PC・ワークフローが重なっても同じ時刻に集中しない）
    busy_wait_sec: 600         # 別のワークフローが取得中なら、終わるのを待ってその結果を使う
    failure_backoff_sec: 300   # 取得が失敗したら、どのワークフローも 5 分（連続するほど倍、最大 1 時間）問い合わせない
    # 同じ GitLab を見るほかの取得元（MR など）と group をそろえると、要求の間隔・失敗の待ちを共有し、同時には取得しない
    rate_limit: { min_interval_sec: 1, group: gitlab }

rules:
  issue-agent:
    source: gitlab-issues
    id: iid
    # これらのどれかが変わったときだけ実行する（updated_at だけの更新では起こさない）
    watch: [title, state, labels, "assignees[*].username", milestone.title, due_date, user_notes_count, description]
    unordered: [labels]
    on: [appeared, changed]
    initial: baseline          # 初回は今ある issue を覚えるだけ
    # 対象の issue。実行の直前に取り直したときにもう一度当てはめ、待つ間に閉じた・ラベルが外れた issue は流さない
    filter: { path: state, value: opened }
    # filter: { all: [{ path: state, value: opened }, { path: labels, op: contains, value: agent }] }
    targets:
      - name: run
        # api-watch は実行しない。Dagu のワークフローのステップが claim → 処理 → finish を呼ぶ
        external: true
        # 処理に渡すプロンプトのテンプレート（この設定ファイルからの相対パスでもよい）。ワークフローの render が展開する
        input_template: ~/.config/dagu/gitlab-issue-agent.prompt.md
        # 実行の前後に issue を 1 件取り直す（ヘッダーは取得元のものを使う）:
        #   - 前: 最新の内容で流す。filter から外れた・前回処理し終えた状態と同じ（自分の書き込みだけ・まとめて処理済み）なら流さない
        #   - 後: その状態を「処理し終えた状態」にする（エージェント自身のコメントでもう一度起きない）
        refresh:
          url: "{{ conn.url }}/api/v4/projects/{{ env.GITLAB_PROJECT | urlencode }}/issues/{{ event.record_id }}"
        # 実行中に自分以外の人がコメント・操作していたら、処理し終えたのは実行前の状態までにする（次の取得でもう一度流す）
        handled_before_if:
          - check: gitlab.others_acted
            # options: { self_username: bot-user }     # 既定はトークンの持ち主
        # エージェント CLI は、プロジェクトをまたいで同時に 1 つだけ（同じ lock の名前を持つ受け渡し先どうし）
        lock: agent-session
        timeout_sec: 4200      # 1 件の上限。ワークフローの handle の timeout_sec にもなる
        max_attempts: 3        # 尽きたら打ち切り、次の変化で拾い直す
        retry_backoff_sec: 300 # 失敗したら、毎分の起動のうちこの秒数（1 回ごとに倍）を過ぎたもので再試行
        order: none            # 打ち切った変化があっても、同じ issue の新しい変化は流す

  # 同じ取得元を別のワークフローでも使う例。dags が api-watch-issue-notify を書き足す。
  # 取得は上の schedule で 1 回にまとまる。
  # issue-notify:
  #   source: gitlab-issues
  #   id: iid
  #   watch: [state]
  #   on: [changed]
  #   targets:
  #     - name: notify
  #       command: [python3, /home/you/bin/notify.py]
  #       timeout_sec: 120
